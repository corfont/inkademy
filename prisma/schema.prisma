// ============================================================================
// Inkademy — Modelo de datos
// Ver docs/DATA-MODEL.md para el diagrama ER y la explicación de cada bloque.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../packages/db/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTIDAD Y ORGANIZACIÓN
// ---------------------------------------------------------------------------

enum GlobalRole {
  STUDENT
  TEACHER
  SUPPORT
  ADMIN
}

enum OAuthProviderType {
  GOOGLE
  MICROSOFT
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  EXECUTIVE
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  passwordHash          String? // null si solo usa OAuth
  firstName             String
  lastName              String
  displayName           String?
  avatarUrl             String?
  globalRole            GlobalRole @default(STUDENT)
  locale                String   @default("es")
  timezone              String   @default("America/Lima")
  emailVerifiedAt       DateTime?
  status                String   @default("active") // active | disabled

  // Perfil progresivo (persona natural) — se completa antes de pago/certificado.
  documentType          String? // DNI, CE, PASSPORT, RUC... (según país)
  documentNumber        String?
  country               String? // ISO-3166 alpha-2
  city                  String?
  address               String?
  birthDate             DateTime?
  phone                 String?
  jobTitle              String?
  companyFreeText       String?
  sector                String?
  interests             String[] @default([])
  experienceLevel       ExperienceLevel?
  // Redes sociales — objeto libre con claves conocidas (linkedin, instagram,
  // facebook, twitter, tiktok); ver socialLinksSchema en packages/shared.
  socialLinks           Json?

  // Firma manuscrita/imagen del docente (PNG/JPG, idealmente fondo
  // transparente) — se usa al generar el certificado si la plantilla
  // incluye el tag {{teacherSignature}}. Solo tiene sentido para docentes,
  // pero se guarda en User (no en un modelo aparte) porque el docente ya
  // es un User con globalRole=TEACHER.
  signatureAssetId      String?
  marketingConsentEmail    Boolean @default(false)
  marketingConsentWhatsapp Boolean @default(false)
  profileCompletedAt    DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  oauthAccounts         OAuthAccount[]
  companyMemberships    CompanyMembership[]
  enrollments           Enrollment[]
  orders                Order[]
  assessmentAttempts    AssessmentAttempt[]
  certificates          Certificate[]
  attendances           Attendance[]
  lessonProgress        LessonProgress[]
  calendarEvents        CalendarEvent[]
  notifications         Notification[]
  supportTicketsCreated SupportTicket[]      @relation("TicketCreatedBy")
  supportMessages       SupportMessage[]
  courseSuggestions     CourseSuggestion[]
  recommendations       Recommendation[]
  auditLogs             AuditLog[]
  teachingCourses       CourseStaff[]
  gradedAnswers         Answer[]             @relation("GradedBy")

  @@index([email])
}

model OAuthAccount {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProviderType
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime          @default(now())

  @@unique([provider, providerAccountId])
}

enum CompanySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

model Company {
  id             String   @id @default(uuid())
  legalName      String
  taxIdType      String   // RUC, NIT, EIN, ...
  taxId          String
  country        String
  billingAddress String?
  sector         String?
  size           CompanySize?
  interests      String[] @default([])
  status         String   @default("active") // active | suspended
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    CompanyMembership[]
  enrollments    Enrollment[]
  seatPools      CompanySeatPool[]
  quotes         Quote[]
  orders         Order[]
  supportTickets SupportTicket[]
  auditLogs      AuditLog[]

  @@unique([country, taxIdType, taxId])
}

enum CompanyMembershipRole {
  COMPANY_ADMIN
  PARTICIPANT
}

enum CompanyMembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

model CompanyMembership {
  id        String                  @id @default(uuid())
  companyId String
  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyMembershipRole
  status    CompanyMembershipStatus @default(INVITED)
  invitedBy String?
  team      String? // agrupación libre para reportes (área/equipo/sede)
  joinedAt  DateTime?
  createdAt DateTime                @default(now())

  @@unique([companyId, userId])
}

// ---------------------------------------------------------------------------
// CATÁLOGO
// ---------------------------------------------------------------------------

model Area {
  id        String     @id @default(uuid())
  slug      String     @unique
  name      Json // { "es": "Gestión", "en": "Management" }
  icon      String?
  order     Int        @default(0)
  subareas  Subarea[]
  courses   Course[]
}

model Subarea {
  id     String  @id @default(uuid())
  slug   String  @unique
  name   Json
  areaId String
  area   Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  courses Course[]
}

enum OfferingModality {
  RECORDED
  LIVE
  HYBRID
}

enum OfferingType {
  COURSE
  WORKSHOP
  SEMINAR
  MASTERCLASS
  PROGRAM
  DIPLOMA
  CORPORATE_INHOUSE
}

enum OfferingLevel {
  INITIAL
  INTERMEDIATE
  ADVANCED
}

enum AccessDurationPolicy {
  DAYS_30
  MONTHS_6
  PERMANENT
}

enum OfferingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Unidad en la que el admin captura la duración del curso (durationHours
// sigue guardando el NÚMERO tal cual lo escribió el admin en esa unidad —
// p. ej. durationUnit=WEEKS + durationHours=8 significa "8 semanas", no
// horas — se renombra la interpretación, no la columna, para no romper a
// todos los consumidores existentes de Course.durationHours).
enum DurationUnit {
  HOURS
  WEEKS
  MONTHS
}

model Course {
  id                     String                @id @default(uuid())
  slug                   String                @unique
  title                  Json // { es, en }
  subtitle               Json? // beneficio ("Aprende a liderar equipos remotos")
  description            Json?
  areaId                 String
  area                   Area                  @relation(fields: [areaId], references: [id])
  subareaId              String?
  subarea                Subarea?              @relation(fields: [subareaId], references: [id])
  modality               OfferingModality
  type                   OfferingType          @default(COURSE)
  level                  OfferingLevel
  language               String                @default("es")
  subtitleLanguages      String[]              @default([])
  durationHours          Float
  durationUnit           DurationUnit          @default(HOURS)
  coverImageAssetId      String?
  syllabusAssetId        String? // sílabo del curso (PDF/Word) — visible para el alumno en el aula
  priceAmount            Decimal               @db.Decimal(10, 2)
  priceCurrency          String                @default("PEN")
  certificationIncluded  Boolean               @default(true)
  accessDurationPolicy   AccessDurationPolicy  @default(PERMANENT)
  status                 OfferingStatus        @default(DRAFT)
  b2bAvailable           Boolean               @default(true)
  b2bPriceAmount          Decimal?             @db.Decimal(10, 2)

  // Descuento/oferta — % sobre priceAmount, con vencimiento opcional. Si
  // discountExpiresAt ya pasó, se trata como si no hubiera descuento (ver
  // catalog.service.ts) sin necesidad de un job que lo "apague" solo.
  discountPercent        Float?
  discountExpiresAt      DateTime?

  // Plantilla de certificado específica para este curso. Si es null, el
  // emisor de certificados cae al comportamiento anterior (la plantilla
  // activa más reciente que coincida con el locale del alumno) — ver
  // CertificateService.checkAndIssueIfEligible.
  certificateTemplateId  String?
  certificateTemplate    CertificateTemplate?  @relation(fields: [certificateTemplateId], references: [id])

  // Rutas progresivas / recomendación
  prerequisiteCourseIds  String[]              @default([])
  nextRecommendedCourseIds String[]            @default([])

  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  modules                CourseModule[]
  liveSessions           LiveSession[]
  assessments            Assessment[]
  enrollments            Enrollment[]
  staff                  CourseStaff[]
  programCourses         ProgramCourse[]
  certificates           Certificate[]
  seatPools              CompanySeatPool[]

  @@index([areaId])
  @@index([status])
}

enum CourseStaffRole {
  TEACHER
  CO_TEACHER
  MODERATOR
}

model CourseStaff {
  id       String          @id @default(uuid())
  courseId String
  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     CourseStaffRole

  @@unique([courseId, userId, role])
}

model CourseModule {
  id        String     @id @default(uuid())
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order     Int
  title     Json
  lessons   Lesson[]
  // Lecturas/documentos del módulo (no de una lección puntual) — principales
  // o complementarias, ver Material.category.
  materials Material[]

  @@index([courseId])
}

enum LessonContentType {
  VIDEO
  PDF
  LINK
  TEXT
  ASSIGNMENT
}

model Lesson {
  id              String             @id @default(uuid())
  moduleId        String
  module          CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order           Int
  title           Json
  contentType     LessonContentType
  videoAssetId    String?
  durationMinutes Int?
  isFreePreview   Boolean            @default(false)
  materials       Material[]
  progress        LessonProgress[]

  @@index([moduleId])
}

// MAIN: lectura/documento principal. SUPPLEMENTARY: complementario (opcional para el alumno).
enum MaterialCategory {
  MAIN
  SUPPLEMENTARY
}

model Material {
  id        String            @id @default(uuid())
  // Un material cuelga de una lección puntual O de un módulo entero (lectura
  // general del módulo) — nunca de ambos. Antes solo existía a nivel de
  // lección.
  lessonId  String?
  lesson    Lesson?           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  moduleId  String?
  module    CourseModule?     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  assetId   String
  kind      String // pdf | slide | doc | sheet | image | video | template | link
  category  MaterialCategory  @default(MAIN)
  // Si es false, el material queda cargado pero oculto para el alumno (el
  // admin/docente lo sigue viendo) — por defecto todo se ve.
  visible   Boolean           @default(true)
  createdAt DateTime          @default(now())
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum VirtualClassroomProviderType {
  TEAMS
}

model LiveSession {
  id               String                       @id @default(uuid())
  courseId         String
  course           Course                       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            Json?
  startsAt         DateTime
  endsAt           DateTime
  timezone         String                       @default("America/Lima")
  capacity         Int?
  status           LiveSessionStatus            @default(SCHEDULED)

  // Integración de aula virtual (Microsoft Teams vía Graph API)
  provider         VirtualClassroomProviderType @default(TEAMS)
  providerMeetingId String?
  joinUrl          String?
  organizerUpn     String?
  recordingUrl     String?

  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  attendances      Attendance[]
  calendarEvents   CalendarEvent[]

  @@index([courseId])
  @@index([startsAt])
}

model Program {
  id                    String          @id @default(uuid())
  slug                  String          @unique
  title                 Json
  description           Json?
  type                  OfferingType    @default(PROGRAM) // PROGRAM | DIPLOMA
  coverImageAssetId     String?
  priceAmount           Decimal         @db.Decimal(10, 2)
  priceCurrency         String          @default("PEN")
  certificationIncluded Boolean         @default(true)
  status                OfferingStatus  @default(DRAFT)
  certificateTemplateId String?
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  courses               ProgramCourse[]
  enrollments           Enrollment[]
  certificates          Certificate[]
  seatPools             CompanySeatPool[]
}

model ProgramCourse {
  id         String  @id @default(uuid())
  programId  String
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id])
  order      Int
  isRequired Boolean @default(true)

  @@unique([programId, courseId])
}

// ---------------------------------------------------------------------------
// MATRÍCULA Y PROGRESO
// ---------------------------------------------------------------------------

enum OfferingKind {
  COURSE
  PROGRAM
}

enum EnrollmentSource {
  B2C_PURCHASE
  B2B_SEAT
  FREE
  ADMIN_GRANTED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

model Enrollment {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  offeringKind    OfferingKind
  courseId        String?
  course          Course?          @relation(fields: [courseId], references: [id])
  programId       String?
  program         Program?         @relation(fields: [programId], references: [id])
  companyId       String? // si vino de un cupo B2B
  company         Company?         @relation(fields: [companyId], references: [id])
  source          EnrollmentSource
  status          EnrollmentStatus @default(ACTIVE)
  accessExpiresAt DateTime?
  progressPct     Float            @default(0)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?

  lessonProgress  LessonProgress[]
  attempts        AssessmentAttempt[]
  certificate     Certificate?

  @@index([userId])
  @@index([companyId])
  @@index([courseId])
  @@index([programId])
}

model LessonProgress {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  completed    Boolean    @default(false)
  lastPositionSeconds Int @default(0)
  updatedAt    DateTime   @updatedAt

  @@unique([enrollmentId, lessonId])
}

model Attendance {
  id            String      @id @default(uuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt      DateTime?
  leftAt        DateTime?
  durationMin   Int?
  source        String      @default("teams_graph_report") // teams_graph_report | manual

  @@unique([liveSessionId, userId])
}

// ---------------------------------------------------------------------------
// EVALUACIÓN Y CERTIFICACIÓN
// ---------------------------------------------------------------------------

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  OPEN
}

model QuestionBank {
  id        String     @id @default(uuid())
  areaId    String?
  name      String
  questions Question[]
}

model Question {
  id             String        @id @default(uuid())
  questionBankId String?
  questionBank   QuestionBank? @relation(fields: [questionBankId], references: [id])
  assessmentId   String?
  assessment     Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  type           QuestionType
  text           Json
  options        Json? // [{ id, text }] para choice/true_false
  correctAnswer  Json? // string | string[] según tipo (null para OPEN)
  points         Float         @default(1)
  tags           String[]      @default([])

  answers        Answer[]
}

enum AssessmentQuestionOrder {
  FIXED
  RANDOM
}

// Cómo se le presentan las preguntas al alumno al rendir el examen: todas
// juntas en una sola pantalla, o una por una (sin poder volver atrás).
enum AssessmentDisplayMode {
  ALL_AT_ONCE
  ONE_BY_ONE
}

model Assessment {
  id                String                  @id @default(uuid())
  courseId          String
  course            Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             Json
  type              String                  @default("quiz") // quiz | exam | assignment
  minScore          Float                   @default(70)
  maxAttempts       Int                     @default(3)
  timeLimitMinutes  Int?
  displayMode       AssessmentDisplayMode   @default(ALL_AT_ONCE)
  questionOrder     AssessmentQuestionOrder @default(FIXED)
  randomizeOptions  Boolean                 @default(false)
  questionsPerAttempt Int? // selección aleatoria desde banco
  availableFrom     DateTime?
  availableUntil    DateTime?

  questions         Question[]
  attempts          AssessmentAttempt[]

  @@index([courseId])
}

enum AttemptStatus {
  IN_PROGRESS
  GRADED
  PENDING_REVIEW
  PASSED
  FAILED
}

model AssessmentAttempt {
  id            String        @id @default(uuid())
  assessmentId  String
  assessment    Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollmentId  String
  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptNumber Int
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  score         Float?
  status        AttemptStatus @default(IN_PROGRESS)

  answers       Answer[]

  @@index([assessmentId, userId])
}

model Answer {
  id           String             @id @default(uuid())
  attemptId    String
  attempt      AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question           @relation(fields: [questionId], references: [id])
  response     Json
  isCorrect    Boolean?
  score        Float?
  gradedById   String?
  gradedBy     User?              @relation("GradedBy", fields: [gradedById], references: [id])
  gradedAt     DateTime?

  @@unique([attemptId, questionId])
}

// Reglas de habilitación de certificado por curso.
model ApprovalRule {
  id                 String  @id @default(uuid())
  courseId           String  @unique
  minProgressPct     Float   @default(100)
  minAttendancePct   Float?  // solo aplica si el curso tiene sesiones en vivo
  minScore           Float   @default(70)
  requiresAssignment Boolean @default(false)
}

// HTML: la plantilla es un documento HTML con tags {{tag}} (ver
// certificate.processor.ts renderPlaceholders) que se renderiza con
// Puppeteer. BACKGROUND: la plantilla es un archivo de diseño ya
// maquetado (PDF, PNG o JPG, ver backgroundMimeType) sobre el que se
// "estampan" los tags en las coordenadas de tagPositions usando pdf-lib
// — si el fondo es PDF se preserva calidad vectorial; si es PNG/JPG se
// incrusta como imagen de fondo de una página nueva.
enum CertificateTemplateSourceType {
  HTML
  BACKGROUND
}

model CertificateTemplate {
  id           String   @id @default(uuid())
  name         String
  locale       String   @default("es")
  htmlTemplate String   @db.Text // solo aplica si sourceType=HTML (se guarda "" si es BACKGROUND)
  version      Int      @default(1)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  sourceType         CertificateTemplateSourceType @default(HTML)
  backgroundAssetId  String? // PDF/PNG/JPG subido como diseño de fondo — solo si sourceType=BACKGROUND
  backgroundMimeType String? // application/pdf | image/png | image/jpeg
  // Tamaño de página en puntos PDF (72pt = 1 pulgada). Si el fondo es un PDF,
  // se ignoran y se usa el tamaño real de esa página.
  pageWidthPt  Float? @default(841.89) // A4 horizontal
  pageHeightPt Float? @default(595.28)
  // [{ tag, xPercent, yPercent, fontSizePt?, color?, align?, widthPercent?, heightPercent? }]
  // Posición de cada tag relativa a la página (0-100%, origen arriba-izquierda,
  // igual que en la vista previa) — solo aplica si sourceType=BACKGROUND.
  tagPositions Json?

  certificates Certificate[]
  courses      Course[]
  programs     Program[]
}

model Certificate {
  id               String               @id @default(uuid())
  code             String               @unique @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id])
  courseId         String?
  course           Course?              @relation(fields: [courseId], references: [id])
  programId        String?
  program          Program?             @relation(fields: [programId], references: [id])
  enrollmentId     String               @unique
  enrollment       Enrollment           @relation(fields: [enrollmentId], references: [id])
  templateId       String
  template         CertificateTemplate  @relation(fields: [templateId], references: [id])
  templateVersion  Int
  finalScore       Float?
  issuedAt         DateTime             @default(now())
  pdfAssetId       String?
  qrUrl            String?
  criteriaSnapshot Json // reglas cumplidas al momento de emitir, para trazabilidad
  revoked          Boolean              @default(false)

  @@index([userId])
  @@index([code])
}

// ---------------------------------------------------------------------------
// COMERCIO
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  companyId   String?
  company     Company?    @relation(fields: [companyId], references: [id])
  subtotal    Decimal     @db.Decimal(10, 2)
  discount    Decimal     @default(0) @db.Decimal(10, 2)
  tax         Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  currency    String      @default("PEN")
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Datos del comprador para la boleta/factura electrónica (SUNAT). Se
  // capturan en el checkout (ver checkoutSchema) y se guardan en la orden —
  // no en ElectronicInvoice directamente — porque finalizeOrderPaid() puede
  // ejecutarse más tarde (webhook async, o a futuro una confirmación manual
  // de transferencia) y para entonces ya no tenemos el body original del
  // POST /checkout. Catálogo 06 SUNAT: 1=DNI, 6=RUC, 4=Carné ext., 7=Pasaporte,
  // 0=extranjero sin documento.
  buyerDocumentType   String?
  buyerDocumentNumber String?
  buyerLegalName      String?
  buyerCountry        String?

  items       OrderItem[]
  payments    Payment[]
  electronicInvoice ElectronicInvoice?
  electronicNotes   ElectronicNote[]
}

enum ElectronicDocumentType {
  BOLETA
  FACTURA
}

enum ElectronicDocumentStatus {
  PENDING // encolada, el worker todavía no la procesa
  SIMULATED // sin credenciales reales de SUNAT configuradas (dev)
  ACCEPTED
  REJECTED
  ERROR
}

/// Comprobante de pago electrónico (boleta/factura SUNAT) de una Order.
/// Se emite automáticamente cuando la Order pasa a PAID — sin importar si
/// fue un pago con tarjeta (Culqi/Stripe, automático) o una confirmación
/// manual futura (ej. transferencia bancaria) — y se omite por completo si
/// el total de la orden es 0 (cursos gratuitos).
model ElectronicInvoice {
  id                  String                   @id @default(uuid())
  orderId             String                   @unique
  order               Order                    @relation(fields: [orderId], references: [id])
  documentType        ElectronicDocumentType
  series              String
  correlativo         Int
  // Catálogo 06 de SUNAT: 1=DNI, 6=RUC, 4=Carné extranjería, 7=Pasaporte,
  // 0=Doc.trib.no.dom.sin.RUC (comprador extranjero sin ninguno de los anteriores).
  buyerDocumentType   String
  buyerDocumentNumber String
  buyerLegalName      String
  buyerCountry        String                   @default("PE")
  currency            String
  totalAmount         Decimal                  @db.Decimal(10, 2)
  xml                 String?                  @db.Text
  cdrXml              String?                  @db.Text
  status              ElectronicDocumentStatus @default(SIMULATED)
  sunatResponseCode   String?
  sunatDescription    String?
  pdfAssetId          String?
  createdAt           DateTime                 @default(now())

  @@unique([documentType, series, correlativo])
}

enum ElectronicNoteType {
  CREDIT // Nota de crédito — catálogo 09 SUNAT (anulación, descuento, etc.)
  DEBIT  // Nota de débito — catálogo 10 SUNAT (intereses, aumento de valor, etc.)
}

/// Nota de crédito/débito SUNAT, ligada a la ElectronicInvoice original que
/// ajusta. Hoy el único disparador real es "el comprador desiste de la
/// compra" (CommerceService.cancelOrder) -> siempre genera CREDIT con
/// motivo "01" (anulación de la operación). DEBIT queda modelado y con XML
/// soportado (ver invoice.processor.ts en apps/worker) para casos futuros
/// (p.ej. corrección de un cobro de menos) pero sin un endpoint que lo
/// dispare todavía.
model ElectronicNote {
  id                   String                   @id @default(uuid())
  orderId              String
  order                Order                    @relation(fields: [orderId], references: [id])
  noteType             ElectronicNoteType
  series               String
  correlativo          Int
  // Documento SUNAT que esta nota ajusta (la ElectronicInvoice original).
  referenceDocType     ElectronicDocumentType
  referenceSeries      String
  referenceCorrelativo Int
  // Catálogo 09 (crédito) / catálogo 10 (débito) de SUNAT.
  reasonCode           String
  reasonDescription    String
  currency             String
  totalAmount          Decimal                  @db.Decimal(10, 2)
  xml                  String?                  @db.Text
  cdrXml               String?                  @db.Text
  status               ElectronicDocumentStatus @default(PENDING)
  sunatResponseCode    String?
  sunatDescription     String?
  pdfAssetId           String?
  createdAt            DateTime                 @default(now())

  @@unique([noteType, series, correlativo])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offeringKind OfferingKind
  courseId   String?
  programId  String?
  seatPoolQty Int? // si la compra es de cupos B2B
  unitPrice  Decimal  @db.Decimal(10, 2)
  quantity   Int      @default(1)
}

enum PaymentProviderType {
  CULQI
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id          String              @id @default(uuid())
  orderId     String
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    PaymentProviderType
  providerRef String? // charge id / payment intent id
  status      PaymentStatus       @default(PENDING)
  amount      Decimal             @db.Decimal(10, 2)
  currency    String
  receiptUrl  String?
  paidAt      DateTime?
  createdAt   DateTime            @default(now())
}

model CompanySeatPool {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offeringKind  OfferingKind
  courseId      String?
  course        Course?   @relation(fields: [courseId], references: [id])
  programId     String?
  program       Program?  @relation(fields: [programId], references: [id])
  seatsPurchased Int
  seatsUsed      Int      @default(0)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([companyId])
}

enum QuoteStatus {
  REQUESTED
  SENT
  ACCEPTED
  REJECTED
}

model Quote {
  id                  String      @id @default(uuid())
  companyId           String
  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedByUserId    String
  offeringDescription String      @db.Text
  status              QuoteStatus @default(REQUESTED)
  salesOwner          String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// AGENDA, NOTIFICACIONES Y SOPORTE
// ---------------------------------------------------------------------------

enum CalendarEventType {
  LIVE_CLASS
  COURSE_START
  COURSE_DEADLINE
  ASSIGNMENT_DUE
  EXAM
  MENTORSHIP
  ACCESS_EXPIRATION
}

model CalendarEvent {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          CalendarEventType
  title         String
  startsAt      DateTime
  endsAt        DateTime?
  icsUid        String            @unique @default(uuid())
  liveSessionId String?
  liveSession   LiveSession?      @relation(fields: [liveSessionId], references: [id])
  createdAt     DateTime          @default(now())

  @@index([userId, startsAt])
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  template  String
  payload   Json?
  status    NotificationStatus   @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String          @id @default(uuid())
  createdById String
  createdBy   User            @relation("TicketCreatedBy", fields: [createdById], references: [id])
  companyId   String?
  company     Company?        @relation(fields: [companyId], references: [id])
  category    String
  priority    TicketPriority  @default(MEDIUM)
  status      TicketStatus    @default(OPEN)
  subject     String
  channel     String          @default("web") // web | whatsapp
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  messages    SupportMessage[]

  @@index([companyId])
  @@index([status])
}

model SupportMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  body       String        @db.Text
  attachmentAssetId String?
  createdAt  DateTime      @default(now())
}

/// Sugerencias libres de los usuarios (ej. "me gustaría un curso de X") —
/// deliberadamente separado de SupportTicket: no es un problema a resolver,
/// es una idea a evaluar para el catálogo futuro.
model CourseSuggestion {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  status    String   @default("NEW") // NEW | REVIEWED | PLANNED | DECLINED
  createdAt DateTime @default(now())

  @@index([status])
}

model Recommendation {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  programId   String?
  reason      String // completed_related | interest_match | level_progression | company_assigned
  score       Float    @default(0)
  generatedAt DateTime @default(now())
  dismissed   Boolean  @default(false)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// SISTEMA
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
}

model CountryConfig {
  id           String   @id @default(uuid())
  country      String   @unique // ISO-3166 alpha-2
  documentTypes Json    // [{ code: "DNI", label: {...}, length: 8 }, ...]
  currency     String
  phonePrefix  String
  taxIdLabel   String? // "RUC", "NIT", ...
}

/// Fila única (id fijo "default") con la identidad visual editable desde
/// /admin/apariencia: logo, tamaño del logo, tipografía y fondo del sitio.
/// El modo claro/oscuro/automático NO vive aquí — es preferencia de cada
/// visitante (localStorage), no una configuración global de la plataforma.
model PlatformSettings {
  id                  String   @id @default("default")
  logoUrl             String?
  logoHeightPx        Int      @default(64)
  headingFontFamily   String   @default("Outfit")
  bodyFontFamily      String   @default("Work Sans")
  backgroundColor     String? // hex, sobreescribe el token --paper
  backgroundImageUrl  String?

  // Datos de contacto mostrados en el pie de página y en /ayuda — antes
  // estaban hardcodeados en Footer.tsx.
  contactEmail        String?
  contactPhone        String?
  contactAddress      String?

  // Qué información se muestra en las tarjetas de curso del catálogo
  // público, a nivel global (no por curso individual). Claves usadas por
  // CourseCard.tsx: showTeacher, showDuration, showNextLiveSession,
  // showCertificationBadge. Si una clave no está presente, se asume true
  // (comportamiento anterior, sin este control) — ver DEFAULT_COURSE_CARD_FIELDS.
  courseCardFields    Json?

  // Firma institucional para certificados (p.ej. Gerente General/Responsable
  // de Inkapitales) — se usa si la plantilla incluye
  // {{institutionSignature}}/{{institutionSignatureName}}/{{institutionSignatureTitle}}.
  institutionSignatureAssetId String?
  institutionSignatureName    String? // p.ej. "Juan Pérez López"
  institutionSignatureTitle   String? // p.ej. "Gerente General"

  updatedAt           DateTime @updatedAt
}

/// Credenciales y datos de facturación electrónica SUNAT (Perú), editables
/// desde /admin/facturacion — antes SOLO se podían configurar vía variables
/// de entorno (.env), sin ninguna pantalla. apps/worker (invoice.processor.ts
/// / credit-note.processor.ts) lee esta fila primero y cae a las variables
/// de entorno si no existe o algún campo viene vacío — así un despliegue
/// existente que ya configuró todo por .env sigue funcionando igual.
model SunatSettings {
  id                  String   @id @default("default")
  env                 String   @default("beta") // beta | production
  ruc                 String?
  solUser             String?
  solPassword         String? // nunca se devuelve tal cual al frontend (ver SunatSettingsService.get)
  razonSocial         String?
  address             String?
  ubigeo              String?
  boletaSeries        String?
  facturaSeries       String?
  boletaCreditSeries  String?
  facturaCreditSeries String?
  certPem             String?  @db.Text // nunca se devuelve tal cual al frontend
  certKeyPem          String?  @db.Text // nunca se devuelve tal cual al frontend
  taxAffectation      String   @default("EXONERADO") // EXONERADO | GRAVADO
  updatedAt           DateTime @updatedAt
}

/// Configuración del asistente/chatbot de IA (widget flotante en el campus),
/// editable desde /admin/asistente-ia. La API key nunca se devuelve tal cual
/// al frontend (mismo patrón que SunatSettings.solPassword) — solo un flag
/// `hasApiKey`. Si no hay fila o `apiKey` viene vacío, se cae a la variable
/// de entorno GEMINI_API_KEY (mismo patrón "DB primero, env de respaldo").
model ChatbotSettings {
  id            String   @id @default("default")
  enabled       Boolean  @default(false)
  provider      String   @default("gemini") // por ahora solo "gemini" (Google AI Studio, capa gratuita)
  model         String   @default("gemini-2.5-flash")
  apiKey        String? // nunca se devuelve tal cual al frontend
  systemPrompt  String?  @db.Text
  updatedAt     DateTime @updatedAt
}
