enum CalendarEventType {
  LIVE_CLASS
  COURSE_START
  COURSE_DEADLINE
  ASSIGNMENT_DUE
  EXAM
  MENTORSHIP
  ACCESS_EXPIRATION
}

model CalendarEvent {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          CalendarEventType
  title         String
  startsAt      DateTime
  endsAt        DateTime?
  icsUid        String            @unique @default(uuid())
  liveSessionId String?
  liveSession   LiveSession?      @relation(fields: [liveSessionId], references: [id])
  // "Si le doy clic a un curso agendado o actividad me debería derivar ya
  // sea al curso o al Teams" — para poder llevar a la ficha del curso en
  // eventos SIN sesión en vivo (COURSE_START, ACCESS_EXPIRATION, etc.). Los
  // LIVE_CLASS ya resuelven el curso vía liveSession.courseId; este campo
  // cubre el resto.
  courseId      String?
  course        Course?           @relation(fields: [courseId], references: [id])
  createdAt     DateTime          @default(now())

  @@index([userId, startsAt])
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Tipo de evento que originó la notificación — usado para filtrar/agrupar
/// en la bandeja in-app y para el on/off por tipo+canal en
/// NotificationSettings. COURSE_ACCESS_EXPIRING/LIVE_SESSION_UPCOMING/
/// ASSESSMENT_DUE ya tenían su sweep (reminder.processor.ts) enviando solo
/// correo — ahora ganan el canal IN_APP. PARTNERSHIP_EXPIRING (convenio por
/// vencer) y SUGGESTION_UNANSWERED son sweeps nuevos. PLATFORM_LICENSE_EXPIRING
/// es del módulo de licencias de arriendo. GENERIC cubre cualquier aviso
/// puntual sin tipo específico (no se lista en NotificationSettings).
enum NotificationType {
  COURSE_ACCESS_EXPIRING
  LIVE_SESSION_UPCOMING
  ASSESSMENT_DUE
  PARTNERSHIP_EXPIRING
  SUPPORT_TICKET_UPDATE
  SUGGESTION_UNANSWERED
  PLATFORM_LICENSE_EXPIRING
  GENERIC
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  template  String
  type      NotificationType    @default(GENERIC)
  title     String?
  body      String?             @db.Text
  url       String?
  payload   Json?
  status    NotificationStatus  @default(PENDING)
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([userId, readAt])
}

/// Configuración de qué notificaciones se envían y por qué canal(es),
/// editable desde /admin/notificaciones. Mismo patrón singleton que
/// ChatbotSettings (id fijo "default"). Cada tipo con sweep real (ver
/// NotificationType) tiene su par enabled/email + enabled/inApp — todos
/// arrancan en true para no cambiar el comportamiento actual de los 3
/// sweeps que ya mandaban correo antes de este módulo.
model NotificationSettings {
  id String @id @default("default")

  courseAccessExpiringEmail Boolean @default(true)
  courseAccessExpiringInApp Boolean @default(true)

  liveSessionUpcomingEmail Boolean @default(true)
  liveSessionUpcomingInApp Boolean @default(true)

  assessmentDueEmail Boolean @default(true)
  assessmentDueInApp Boolean @default(true)

  partnershipExpiringEmail    Boolean @default(true)
  partnershipExpiringInApp    Boolean @default(true)
  partnershipExpiringLeadDays Int     @default(30)

  supportTicketUpdateEmail Boolean @default(true)
  supportTicketUpdateInApp Boolean @default(true)

  suggestionUnansweredEmail      Boolean @default(false)
  suggestionUnansweredInApp      Boolean @default(true)
  suggestionUnansweredAfterHours Int     @default(48)

  platformLicenseExpiringEmail    Boolean @default(true)
  platformLicenseExpiringInApp    Boolean @default(true)
  platformLicenseExpiringLeadDays Int     @default(30)

  updatedAt DateTime @updatedAt
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String         @id @default(uuid())
  createdById String
  createdBy   User           @relation("TicketCreatedBy", fields: [createdById], references: [id])
  companyId   String?
  company     Company?       @relation(fields: [companyId], references: [id])
  category    String
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  subject     String
  channel     String         @default("web") // web | whatsapp
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages SupportMessage[]

  @@index([companyId])
  @@index([status])
}

model SupportMessage {
  id                String        @id @default(uuid())
  ticketId          String
  ticket            SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Nullable: un mensaje puede venir de la IA (isAiGenerated=true) sin
  // ningún User real detrás — "si la IA puede resolver el caso lo debe
  // hacer inmediatamente ayudando al usuario".
  authorId          String?
  author            User?         @relation(fields: [authorId], references: [id])
  isAiGenerated     Boolean       @default(false)
  body              String        @db.Text
  attachmentAssetId String?
  createdAt         DateTime      @default(now())
}

/// Sugerencias libres de los usuarios (ej. "me gustaría un curso de X") —
/// deliberadamente separado de SupportTicket: no es un problema a resolver,
/// es una idea a evaluar para el catálogo futuro.
model CourseSuggestion {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  status    String   @default("NEW") // NEW | REVIEWED | PLANNED | DECLINED
  createdAt DateTime @default(now())

  // Respuesta del admin — antes una sugerencia solo tenía un estado interno
  // y quien la envió nunca se enteraba de nada. `adminResponse` se manda
  // por correo a `user` cuando se guarda (ver SuggestionsService.respond).
  adminResponse String?   @db.Text
  respondedAt   DateTime?
  respondedById String?
  respondedBy   User?     @relation("SuggestionRespondedBy", fields: [respondedById], references: [id])
  // true = la envió sola la IA (tras el plazo configurado, sin que el admin
  // la haya tocado) — respondedById queda null en ese caso. false/no tocado
  // = la escribió o aprobó un admin/soporte real.
  respondedByAi Boolean   @default(false)

  @@index([status])
}

model Recommendation {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  programId   String?
  reason      String // completed_related | interest_match | level_progression | company_assigned
  score       Float    @default(0)
  generatedAt DateTime @default(now())
  dismissed   Boolean  @default(false)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// SISTEMA
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model CountryConfig {
  id            String  @id @default(uuid())
  country       String  @unique // ISO-3166 alpha-2
  documentTypes Json // [{ code: "DNI", label: {...}, length: 8 }, ...]
  currency      String
  phonePrefix   String
  taxIdLabel    String? // "RUC", "NIT", ...
}

/// Fila única (id fijo "default") con la identidad visual editable desde
/// /admin/apariencia: logo, tamaño del logo, tipografía y fondo del sitio.
/// El modo claro/oscuro/automático NO vive aquí — es preferencia de cada
/// visitante (localStorage), no una configuración global de la plataforma.
model PlatformSettings {
  id                 String  @id @default("default")
  logoUrl            String?
  logoHeightPx       Int     @default(64)
  headingFontFamily  String  @default("Outfit")
  bodyFontFamily     String  @default("Work Sans")
  backgroundColor    String? // hex, sobreescribe el token --paper
  backgroundImageUrl String?

  // Datos de contacto mostrados en el pie de página y en /ayuda — antes
  // estaban hardcodeados en Footer.tsx.
  contactEmail   String?
  contactPhone   String?
  contactAddress String?

  // Qué información se muestra en las tarjetas de curso del catálogo
  // público, a nivel global (no por curso individual). Claves usadas por
  // CourseCard.tsx: showTeacher, showDuration, showNextLiveSession,
  // showCertificationBadge. Si una clave no está presente, se asume true
  // (comportamiento anterior, sin este control) — ver DEFAULT_COURSE_CARD_FIELDS.
  courseCardFields Json?

  // Firma institucional para certificados (p.ej. Gerente General/Responsable
  // de Inkapitales) — se usa si la plantilla incluye
  // {{institutionSignature}}/{{institutionSignatureName}}/{{institutionSignatureTitle}}.
  institutionSignatureAssetId String?
  institutionSignatureName    String? // p.ej. "Juan Pérez López"
  institutionSignatureTitle   String? // p.ej. "Gerente General"

  // Comisión que cobra cada pasarela por transacción exitosa — el % exacto
  // depende del contrato comercial de Inkademy con Culqi/Stripe (varía por
  // volumen), así que se deja configurable acá en vez de un valor fijo en
  // código. Usado por AdminService.getFinancialSummary para estimar cuánto
  // de lo cobrado en realidad se va a la pasarela.
  // 3.44% es la tarifa publicada de Culqi para tarjeta nacional + Yape/Plin
  // (+ IGV) — antes decía 3.99%, que es la tarifa de tarjeta INTERNACIONAL
  // (ver stripeFeePercent, que sí corresponde a compradores extranjeros).
  culqiFeePercent  Float @default(3.44)
  stripeFeePercent Float @default(4.99)
  // "Las comisiones de Yape/Plin son separadas, no juntas" — corrección
  // explícita del admin: SÍ es un costo real para Inkapitales (el
  // comercio), no del comprador — BCP cobra por recibir Yape en cuenta
  // empresa, Interbank cobra por recibir Plin en cuenta empresa, cada uno
  // con su propia tasa (no hay razón para que coincidan, son bancos
  // distintos). Este % es ADICIONAL a `culqiFeePercent` (la pasarela sigue
  // cobrando su comisión de "descuento de comercio" aparte) — ver
  // AdminService.getFinancialSummary, que ahora distingue por
  // Payment.paymentMethod ("yape" vs "plin") en vez de tratarlos como una
  // sola billetera. Cada uno en 0 por defecto hasta que el admin cargue la
  // tasa real que le confirmó su banco.
  yapeFeePercent   Float @default(0)
  plinFeePercent   Float @default(0)

  // Detracción SUNAT (Sistema de Pago de Obligaciones Tributarias) — la
  // tabla de reglas depende de qué tipo de comprobante recibe el
  // comprador, no es un % único. Ver AdminService.computeDetraction:
  // - Persona natural (boleta, DNI): nunca aplica.
  // - Persona natural con negocio (factura, RUC que empieza con "10"):
  //   aplica detractionRucNaturalPercent solo si el monto supera
  //   detractionRucNaturalThreshold.
  // - Empresa/persona jurídica (factura, RUC que empieza con "20"): aplica
  //   detractionRucEmpresaPercent siempre.
  // detractionEnabled es el interruptor maestro — si la SUNAT alguna vez
  // suspende la detracción por completo, se apaga acá sin tocar los %.
  detractionEnabled             Boolean @default(true)
  detractionRucNaturalPercent   Float   @default(12)
  detractionRucNaturalThreshold Float   @default(700)
  detractionRucEmpresaPercent   Float   @default(12)

  // "Aunque la factura sea en dólares, se debe pagar la detracción con el
  // tipo de cambio del dólar del día" — la detracción de una venta en USD
  // igual se calcula y se deposita en SOLES al Banco de la Nación, nunca en
  // dólares. usdExchangeRate es el tipo de cambio vigente que el admin
  // actualiza a mano (la fuente oficial recomendada — SBS — no se scrapea
  // automáticamente: es una página gubernamental que puede cambiar de
  // estructura sin aviso, y un tipo de cambio mal leído significa una
  // detracción mal calculada, un riesgo tributario real). exchangeRateSourceUrl
  // es el link de referencia que el admin ve al lado del campo para
  // consultar el tipo de cambio del día antes de actualizarlo — configurable
  // porque "esa página podría variar".
  usdExchangeRate       Float   @default(3.75)
  exchangeRateSourceUrl String? @default("https://www.sbs.gob.pe/app/pp/sistip_portal/paginas/publicacion/tipocambiopromedio.aspx")

  // Sello de agua (logo) mostrado sobre las pantallas — "para que figure en
  // las pantallas" (pedido explícito). Opacidad/tamaño calibrables; sin
  // watermarkAssetId no se muestra nada (comportamiento anterior).
  watermarkAssetId     String?
  watermarkOpacityPct  Int     @default(15) // 0-100
  watermarkSizePercent Int     @default(30) // 0-100, ancho relativo a la pantalla

  // Menús (barra lateral): color de fondo, tipografía/tamaño/color del texto
  // — antes fijos en el CSS (bg-ink-900, la tipografía global del sitio).
  sidebarColor   String?
  menuFontFamily String?
  menuFontSizePx Int?
  menuFontColor  String?

  // Colores primario/de acento de marca (manual de marca Inkapitales:
  // #586BD8 primario, #D8B26C acento dorado) — ya son el default real
  // horneado en globals.css; estos campos permiten al admin anular esa
  // tonalidad puntual sin tocar código, si algún día cambia el manual.
  primaryColor String?
  accentColor  String?

  // "El texto que acompaña el link del certificado por correo debe ser
  // editable (tipo de letra, justificado, color)" — antes el párrafo de
  // NotificationService.sendCertificateReady estaba escrito a mano en el
  // código, sin ningún control desde el admin. Localizado {es,en} como el
  // resto de textos de plataforma; admite los mismos placeholders
  // {{courseTitle}}/{{verificationUrl}} que ya resuelve
  // notification.service.ts al armar el correo. null = usa el texto por
  // defecto de siempre.
  certificateEmailText       Json?
  certificateEmailFontFamily String?
  certificateEmailTextAlign  String? @default("left") // left | center | right | justify
  certificateEmailTextColor  String?

  updatedAt DateTime @updatedAt
}

/// Gastos que el admin registra a mano (hosting, marketing, nómina de
/// docentes, etc.) — antes no existía ningún lugar para llevar cuenta de
/// "otros gastos" fuera de lo que ya modela el sistema (comisión de
/// pasarela, IGV). Alimenta el "Saldo total" de /admin/finanzas.
model PlatformExpense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("PEN")
  category    String   @default("OTHER") // HOSTING | MARKETING | PAYROLL | OTHER
  incurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  // "Tengo un hosting que me cuesta anualmente, un dominio que me cuesta
  // anualmente, otros gastos que podrían ser mensuales" — un gasto
  // recurrente se registra UNA vez y el estado de resultados lo prorratea
  // por mes (ANNUAL: amount/12, MONTHLY: amount tal cual) en vez de tener
  // que reingresarlo a mano cada período.
  recurrence  String   @default("ONCE") // ONCE | MONTHLY | ANNUAL

  @@index([incurredAt])
}

/// Credenciales y datos de facturación electrónica SUNAT (Perú), editables
/// desde /admin/facturacion — antes SOLO se podían configurar vía variables
/// de entorno (.env), sin ninguna pantalla. apps/worker (invoice.processor.ts
/// / credit-note.processor.ts) lee esta fila primero y cae a las variables
/// de entorno si no existe o algún campo viene vacío — así un despliegue
/// existente que ya configuró todo por .env sigue funcionando igual.
model SunatSettings {
  id                  String   @id @default("default")
  env                 String   @default("beta") // beta | production
  ruc                 String?
  solUser             String?
  solPassword         String? // nunca se devuelve tal cual al frontend (ver SunatSettingsService.get)
  razonSocial         String?
  address             String?
  ubigeo              String?
  boletaSeries        String?
  facturaSeries       String?
  boletaCreditSeries  String?
  facturaCreditSeries String?
  certPem             String?  @db.Text // nunca se devuelve tal cual al frontend
  certKeyPem          String?  @db.Text // nunca se devuelve tal cual al frontend
  // "Esta plataforma no está exonerada del IGV, no soy una institución
  // educativa. Cuando lo sea no aplicará" — por defecto GRAVADO (se cobra
  // IGV); el admin lo cambia a EXONERADO explícitamente solo si Inkapitales
  // llega a calificar como institución educativa reconocida.
  taxAffectation      String   @default("GRAVADO") // EXONERADO | GRAVADO
  // % de IGV vigente — 18% en Perú desde 2011, pero es una tasa que fija el
  // Estado y puede cambiar; se deja parametrizable en vez de hardcodeado.
  // Usado tanto en el XML real de boleta/factura (apps/worker/src/lib/sunat)
  // como en el estimado de /admin/finanzas.
  igvPercent          Float    @default(18)
  updatedAt           DateTime @updatedAt
}

/// Configuración del asistente/chatbot de IA (widget flotante en el campus),
/// editable desde /admin/asistente-ia. La API key nunca se devuelve tal cual
/// al frontend (mismo patrón que SunatSettings.solPassword) — solo un flag
/// `hasApiKey`. Si no hay fila o `apiKey` viene vacío, se cae a la variable
/// de entorno GEMINI_API_KEY (mismo patrón "DB primero, env de respaldo").
model ChatbotSettings {
  id           String  @id @default("default")
  enabled      Boolean @default(false)
  provider     String  @default("gemini") // por ahora solo "gemini" (Google AI Studio, capa gratuita)
  model        String  @default("gemini-2.5-flash")
  apiKey       String? // nunca se devuelve tal cual al frontend
  systemPrompt String? @db.Text

  // Respuesta automática a sugerencias — "parametrizarse si se quiere de
  // manera automática o si se quiere un paso extra donde el administrador
  // dé su aprobación". Si está activo, se envía sola tras
  // suggestionAutoRespondDelayMinutes (para que no llegue "inmediato" y se
  // note que es una IA) — a menos que el admin ya la haya respondido a
  // mano antes de que se cumpla el plazo.
  suggestionAutoRespond             Boolean @default(false)
  suggestionAutoRespondDelayMinutes Int     @default(30)

  updatedAt DateTime @updatedAt
}

/// Documentos que el admin sube (PDF/TXT/MD, p.ej. el manual de ayuda de la
/// plataforma) para que el asistente de IA los use como fuente real en vez
/// de responder de forma genérica — ver ChatbotService.sendMessage, que
/// concatena `extractedText` de todos los documentos activos como contexto
/// antes de llamar a Gemini.
model ChatbotDocument {
  id            String   @id @default(uuid())
  title         String
  assetId       String
  mimeType      String
  extractedText String   @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// SERVIDOR DE CORREO (SMTP) — antes solo configurable vía variables de
// entorno del worker, sin ninguna pantalla de admin. Mismo patrón "DB
// primero, env de respaldo" que SunatSettings/ChatbotSettings.
// ---------------------------------------------------------------------------
model EmailServerSettings {
  id        String   @id @default("default")
  host      String?
  port      Int?
  secure    Boolean  @default(true) // true = TLS/SSL (puerto 465), false = STARTTLS (587)
  username  String?
  password  String? // nunca se devuelve tal cual al frontend
  fromEmail String?
  fromName  String?
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// CAMPAÑAS DE CORREO A CLIENTES — "un módulo donde enviar correos a
// nuestros clientes... programado automático con IA, o que uno redacte y
// parametrice para mandar correos masivos."
// ---------------------------------------------------------------------------
enum EmailCampaignMode {
  AUTOMATIC_AI
  MANUAL
}

// Solo aplica si mode=AUTOMATIC_AI — qué le pide el admin a la IA que redacte.
enum EmailCampaignGoal {
  RELATED_COURSES
  NEW_COURSES
  DISCOUNTED_COURSES
  BY_INTEREST
  // "Detección de riesgo de abandono + reenganche" — a diferencia de los
  // demás goals (un correo por grupo de interés, ver bucketByInterest en
  // email-campaign.processor.ts), este redacta un correo 1:1 por alumno
  // mencionando SU curso puntual y hace cuánto no avanza.
  AT_RISK_REENGAGEMENT
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  // Estado transitorio: el sweep del worker ya "reclamó" la campaña (claim
  // atómico, ver email-campaign.processor.ts) y está enviando — evita que
  // un reinicio a mitad de envío haga que el siguiente sweep la reenvíe
  // completa desde cero.
  SENDING
  SENT
  CANCELLED
}

enum EmailCampaignRecurrence {
  ONCE
  WEEKLY
  MONTHLY
}

model EmailCampaign {
  id             String                  @id @default(uuid())
  name           String
  mode           EmailCampaignMode
  goal           EmailCampaignGoal?
  status         EmailCampaignStatus     @default(DRAFT)
  subject        String?
  bodyHtml       String?                 @db.Text
  // Filtro de audiencia — {areaIds:[], interests:[], inactiveDays:, companyId:}.
  // null = todos los usuarios activos con marketingConsentEmail=true.
  audienceFilter Json?
  scheduledAt    DateTime?
  sentAt         DateTime?
  recurrence     EmailCampaignRecurrence @default(ONCE)
  recipientCount Int                     @default(0)
  createdById    String?
  createdBy      User?                   @relation(fields: [createdById], references: [id])
  createdAt      DateTime                @default(now())

  @@index([status])
}

// ---------------------------------------------------------------------------
// LIQUIDACIÓN DE DOCENTES — tarifa por hora dictada / por otras actividades
// (calificar exámenes manuales), tolerancia de tardanza/salida temprana,
// adelantos, y la liquidación final por periodo.
// ---------------------------------------------------------------------------
enum PaymentFrequency {
  DAILY
  WEEKLY
  MONTHLY
  END_OF_COURSE
}

/// Tarifa de un docente — global (courseId=null) o específica de un curso
/// (para docentes con distinta tarifa según el curso que dicten).
model TeacherRate {
  id                        String           @id @default(uuid())
  teacherId                 String
  teacher                   User             @relation("TeacherRateOwner", fields: [teacherId], references: [id], onDelete: Cascade)
  courseId                  String?
  course                    Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  hourlyRateTeaching        Decimal          @default(0) @db.Decimal(10, 2)
  hourlyRateOtherActivities Decimal          @default(0) @db.Decimal(10, 2)
  currency                  String           @default("PEN")
  // "La tolerancia al inicio de clase y la tolerancia al final son
  // diferentes" — antes un solo valor se restaba igual a la tardanza
  // (llegó tarde) y a la salida temprana (se fue antes) de cada sesión.
  // Ahora cada una tiene su propio margen antes de que empiece a
  // descontar de la liquidación — ver AdminService.computeSessionPayableMinutes.
  toleranceStartMinutes     Int              @default(10)
  toleranceEndMinutes       Int              @default(10)
  paymentFrequency          PaymentFrequency @default(MONTHLY)
  active                    Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@unique([teacherId, courseId])
}

/// Horas registradas manualmente por actividades sin sesión en vivo
/// asociada (p.ej. calificar exámenes) — no hay forma de medir esto
/// automáticamente, así que el admin (o el propio docente) las ingresa.
model TeacherActivityLog {
  id           String   @id @default(uuid())
  teacherId    String
  teacher      User     @relation("TeacherActivityOwner", fields: [teacherId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id])
  activityType String   @default("GRADING") // GRADING | OTHER
  hours        Float
  note         String?
  loggedAt     DateTime @default(now())
}

/// Adelanto de pago a un docente — se descuenta de su próxima liquidación.
model TeacherAdvance {
  id            String              @id @default(uuid())
  teacherId     String
  teacher       User                @relation("TeacherAdvanceOwner", fields: [teacherId], references: [id], onDelete: Cascade)
  amount        Decimal             @db.Decimal(10, 2)
  currency      String              @default("PEN")
  grantedAt     DateTime            @default(now())
  note          String?
  liquidationId String?
  liquidation   TeacherLiquidation? @relation(fields: [liquidationId], references: [id])
}

enum LiquidationStatus {
  DRAFT
  APPROVED
  PAID
}

/// Liquidación de un docente por un periodo — horas dictadas (con
/// descuento por tardanza/salida temprana más allá de la tolerancia, nunca
/// se paga de más por quedarse tiempo extra) + horas de otras actividades,
/// menos adelantos ya otorgados. `detail` guarda el desglose sesión por
/// sesión para que el admin pueda revisar/perdonar penalidades puntuales.
model TeacherLiquidation {
  id                   String            @id @default(uuid())
  teacherId            String
  teacher              User              @relation("TeacherLiquidationOwner", fields: [teacherId], references: [id], onDelete: Cascade)
  periodStart          DateTime
  periodEnd            DateTime
  hoursTeaching        Float             @default(0)
  hoursOtherActivities Float             @default(0)
  grossAmount          Decimal           @default(0) @db.Decimal(10, 2)
  deductions           Decimal           @default(0) @db.Decimal(10, 2)
  deductionsWaived     Boolean           @default(false)
  waivedReason         String?
  advancesDeducted     Decimal           @default(0) @db.Decimal(10, 2)
  netAmount            Decimal           @default(0) @db.Decimal(10, 2)
  currency             String            @default("PEN")
  status               LiquidationStatus @default(DRAFT)
  // `detail` (sesión por sesión) ahora también guarda un snapshot de las
  // tarifas/tolerancia realmente usadas al momento de generar — antes solo
  // guardaba minutos, así que si alguien editaba la tarifa del docente
  // DESPUÉS, ya no había forma de reconstruir con qué tarifa se calculó
  // este monto (hallazgo de auditoría de trazabilidad).
  detail               Json?
  createdAt            DateTime          @default(now())
  paidAt               DateTime?

  // Quién generó / aprobó / pagó / perdonó la deducción — antes ninguna de
  // estas cuatro acciones (las de más impacto financiero/legal de todo el
  // sistema) dejaba rastro de qué admin la hizo (hallazgo de auditoría).
  createdById  String?
  approvedById String?
  paidById     String?
  waivedById   String?
  waivedAt     DateTime?

  advances TeacherAdvance[]
}

// ---------------------------------------------------------------------------
// REGALÍAS (ROYALTIES) — un curso puede pagarle un % a quien lo trajo/lo
// dicta bajo convenio de regalías: por alumno matriculado, por alumno que
// termina el curso, o por referido. Quien recibe la regalía NO es un
// usuario de la plataforma (no inicia sesión) — se administra como una
// entidad externa, igual que PartnerInstitution.
// ---------------------------------------------------------------------------
enum RoyaltyBillingType {
  PER_ENROLLMENT // por cada alumno matriculado
  PER_COMPLETION // por cada alumno que termina el curso
  PER_REFERRAL // % de lo que paga cada alumno que esa persona trajo
}

model RoyaltyRecipient {
  id           String             @id @default(uuid())
  // "El que recibe regalías puede ser un docente, un personal externo,
  // inclusive un alumno... depende de lo que la empresa quiera ofrecer" —
  // opcionalmente vinculado a una cuenta real de la plataforma (de
  // cualquier rol: docente/alumno/soporte/externo). Si es null, sigue
  // siendo un contacto externo sin cuenta (comportamiento anterior, solo
  // name/contactEmail) — no se exige tener cuenta para cobrar regalías.
  userId       String?
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  contactEmail String?
  billingType  RoyaltyBillingType @default(PER_ENROLLMENT)
  feePercent   Float              @default(0)
  feeCurrency  String             @default("PEN")
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  courses CourseRoyalty[]
}

// "¿Puedo poner colores, tipos de letra, tamaño?" — brand kit reutilizable
// del equipo para el editor de autoría SCORM (ver ScormTheme en
// packages/shared/scorm-authoring.ts). Los 4 presets "de fábrica" NO viven
// acá — son constantes en @inkademy/shared, siempre disponibles sin ir a
// la base; esta tabla es solo para los que el propio equipo guarda.
model ScormThemePreset {
  id          String   @id @default(uuid())
  name        String
  theme       Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// "También debería de poderse crear listas de correo... y poderlas
// reutilizar, actualizar, borrar" — audiencia de marketing guardada y
// reutilizable entre campañas (antes el filtro solo vivía suelto dentro
// de cada EmailCampaign.audienceFilter, sin forma de reusarlo). `filter`
// es el mismo shape que emailAudienceFilterSchema/EmailCampaign.audienceFilter
// (null = todos los activos con consentimiento de marketing). A diferencia
// de ScormThemePreset, esta sí se edita después de creada (updatedAt).
model MailingList {
  id          String   @id @default(uuid())
  name        String
  description String?
  filter      Json?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CourseRoyalty {
  id                 String           @id @default(uuid())
  courseId           String
  course             Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  royaltyRecipientId String
  royaltyRecipient   RoyaltyRecipient @relation(fields: [royaltyRecipientId], references: [id], onDelete: Cascade)
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime         @default(now())

  @@unique([courseId, royaltyRecipientId])
  @@index([courseId])
}

enum BackupStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum BackupTrigger {
  MANUAL
  SCHEDULED
}

// "Toda la base de datos... que si se pierde lo pueda recuperar, o si me
// hacen alguna auditoría lo pueda sustentar" — un export completo de todos
// los modelos (vía Prisma.dmmf, ver apps/worker/src/lib/backup.ts) más los
// binarios chicos y con valor legal (certificados, firmas de convenios,
// facturas electrónicas), empaquetado en un zip subido a S3/MinIO.
model BackupRecord {
  id            String        @id @default(uuid())
  trigger       BackupTrigger
  status        BackupStatus  @default(PENDING)
  triggeredById String?
  triggeredBy   User?         @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  s3Key         String?
  sizeBytes     Int?
  modelCounts   Json?
  errorMessage  String?
  createdAt     DateTime      @default(now())
  finishedAt    DateTime?
}
