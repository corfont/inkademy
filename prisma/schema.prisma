// ============================================================================
// Inkademy — Modelo de datos
// Ver docs/DATA-MODEL.md para el diagrama ER y la explicación de cada bloque.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../packages/db/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTIDAD Y ORGANIZACIÓN
// ---------------------------------------------------------------------------

enum GlobalRole {
  STUDENT
  TEACHER
  SUPPORT
  ADMIN
  // "Debe existir el rol Empresa" — quien crea una empresa (y no tenía ya
  // un rol más específico como TEACHER/ADMIN/SUPPORT) pasa a tener este
  // como rol principal, con acceso directo a /empresa al iniciar sesión en
  // vez de caer siempre en el panel de alumno (ver CompaniesService.create
  // y (auth)/login/page.tsx). El control de acceso real a cada empresa
  // sigue siendo CompanyMembership (CompanyGuard), no este rol — este solo
  // decide a qué panel entra por defecto.
  COMPANY
  // "Personal externo que solo busca regalías" — sin acceso a ningún panel
  // (ni admin ni campus), solo existe para que RoyaltyRecipient.userId
  // pueda apuntar a una cuenta real en vez de quedar como contacto sin
  // cuenta (ver RoyaltyRecipient en el modelo de regalías).
  EXTERNAL
}

enum OAuthProviderType {
  GOOGLE
  MICROSOFT
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  EXECUTIVE
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String? // null si solo usa OAuth
  firstName        String
  lastName         String
  displayName      String?
  avatarUrl        String?
  globalRole       GlobalRole   @default(STUDENT)
  // Roles adicionales — "un docente podría ser también alumno, administrador
  // y soporte al mismo tiempo". globalRole sigue siendo el rol PRINCIPAL
  // (decide a qué panel entra por defecto al iniciar sesión y qué muestra
  // el sidebar); secondaryRoles solo AMPLÍA qué otras áreas puede visitar
  // (los guards de la API validan globalRole+secondaryRoles juntos, ver
  // RequestUser.roles en jwt.strategy.ts).
  secondaryRoles   GlobalRole[] @default([])
  locale           String       @default("es")
  timezone         String       @default("America/Lima")
  emailVerifiedAt  DateTime?
  status           String       @default("active") // active | disabled
  // "Al iniciar sesión, generar un session_uuid único y guardarlo; en cada
  // petición contrastar el del token con el de la base — si no coinciden,
  // destruir la sesión actual (inicio de sesión concurrente en otro
  // dispositivo)." null = cuenta que nunca inició sesión desde que existe
  // este campo (o token emitido antes de este cambio, sin `sid`) — en ese
  // caso NO se exige el chequeo, para no invalidar de golpe todas las
  // sesiones activas al desplegar esto. Ver JwtStrategy/AuthService.
  currentSessionId String?

  // Perfil progresivo (persona natural) — se completa antes de pago/certificado.
  documentType    String? // DNI, CE, PASSPORT, RUC... (según país)
  documentNumber  String?
  country         String? // ISO-3166 alpha-2
  city            String?
  address         String?
  birthDate       DateTime?
  phone           String?
  jobTitle        String?
  companyFreeText String?
  sector          String?
  interests       String[]         @default([])
  experienceLevel ExperienceLevel?
  // Redes sociales — objeto libre con claves conocidas (linkedin, instagram,
  // facebook, twitter, tiktok); ver socialLinksSchema en packages/shared.
  socialLinks     Json?

  // Firma manuscrita/imagen del docente (PNG/JPG, idealmente fondo
  // transparente) — se usa al generar el certificado si la plantilla
  // incluye el tag {{teacherSignature}}. Solo tiene sentido para docentes,
  // pero se guarda en User (no en un modelo aparte) porque el docente ya
  // es un User con globalRole=TEACHER.
  signatureAssetId         String?
  // "Los docentes deberán poder registrar su número de cuenta bancaria,
  // CCI y banco" — para que el admin sepa a dónde transferir la
  // liquidación. Mismo criterio que signatureAssetId: vive en User (no en
  // un modelo aparte) porque el docente ya es un User con globalRole=TEACHER.
  bankName                 String?
  bankAccountNumber        String?
  bankAccountCci           String?
  marketingConsentEmail    Boolean   @default(false)
  marketingConsentWhatsapp Boolean   @default(false)
  profileCompletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthAccounts         OAuthAccount[]
  companyMemberships    CompanyMembership[]
  enrollments           Enrollment[]
  orders                Order[]
  assessmentAttempts    AssessmentAttempt[]
  certificates          Certificate[]
  attendances           Attendance[]
  lessonProgress        LessonProgress[]
  materialProgress      MaterialProgress[]
  materialScormProgress MaterialScormProgress[]
  savedCourses          SavedCourse[]
  lessonNotes           LessonNote[]
  courseRatings         CourseRating[]
  royaltyRecipient      RoyaltyRecipient[]
  scormThemePresets     ScormThemePreset[]
  mailingLists          MailingList[]
  backupsTriggered      BackupRecord[]
  calendarEvents        CalendarEvent[]
  notifications         Notification[]
  supportTicketsCreated SupportTicket[]         @relation("TicketCreatedBy")
  supportMessages       SupportMessage[]
  courseSuggestions     CourseSuggestion[]
  suggestionResponses   CourseSuggestion[]      @relation("SuggestionRespondedBy")
  recommendations       Recommendation[]
  auditLogs             AuditLog[]
  teachingCourses       CourseStaff[]
  gradedAnswers         Answer[]                @relation("GradedBy")
  taughtLiveSessions    LiveSession[]           @relation("LiveSessionTeacher")
  emailCampaignsCreated EmailCampaign[]
  teacherRates          TeacherRate[]           @relation("TeacherRateOwner")
  activityLogs          TeacherActivityLog[]    @relation("TeacherActivityOwner")
  advances              TeacherAdvance[]        @relation("TeacherAdvanceOwner")
  liquidations          TeacherLiquidation[]    @relation("TeacherLiquidationOwner")

  @@index([email])
}

model OAuthAccount {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProviderType
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime          @default(now())

  @@unique([provider, providerAccountId])
}

enum CompanySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

model Company {
  id             String       @id @default(uuid())
  legalName      String
  taxIdType      String // RUC, NIT, EIN, ...
  taxId          String
  country        String
  billingAddress String?
  sector         String?
  size           CompanySize?
  interests      String[]     @default([])
  status         String       @default("active") // active | suspended
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // "El administrador puede escoger si quiere que los certificados le
  // lleguen al administrador, al usuario o a ambos" — el COMPANY_ADMIN de
  // esta empresa decide a quién se envía por correo el certificado cuando
  // se emite automáticamente (la descarga desde la plataforma siempre está
  // disponible para el alumno sin importar esta opción — esto solo cambia
  // a dónde llega el correo). STUDENT (default) preserva el comportamiento
  // de siempre.
  certificateDeliveryTarget String @default("STUDENT") // STUDENT | COMPANY_ADMIN | BOTH

  memberships    CompanyMembership[]
  enrollments    Enrollment[]
  seatPools      CompanySeatPool[]
  quotes         Quote[]
  orders         Order[]
  supportTickets SupportTicket[]
  auditLogs      AuditLog[]
  npsResponses   NpsSurveyResponse[]

  @@unique([country, taxIdType, taxId])
}

enum CompanyMembershipRole {
  COMPANY_ADMIN
  PARTICIPANT
}

enum CompanyMembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

model CompanyMembership {
  id        String                  @id @default(uuid())
  companyId String
  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyMembershipRole
  status    CompanyMembershipStatus @default(INVITED)
  invitedBy String?
  team      String? // agrupación libre para reportes (área/equipo/sede)
  joinedAt  DateTime?
  createdAt DateTime                @default(now())

  @@unique([companyId, userId])
}

// ---------------------------------------------------------------------------
// CATÁLOGO
// ---------------------------------------------------------------------------

model Area {
  id       String    @id @default(uuid())
  slug     String    @unique
  name     Json // { "es": "Gestión", "en": "Management" }
  icon     String?
  order    Int       @default(0)
  subareas Subarea[]
  courses  Course[]
}

model Subarea {
  id      String   @id @default(uuid())
  slug    String   @unique
  name    Json
  areaId  String
  area    Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  courses Course[]
}

enum OfferingModality {
  RECORDED
  LIVE
  HYBRID
}

enum OfferingType {
  COURSE
  WORKSHOP
  SEMINAR
  MASTERCLASS
  PROGRAM
  DIPLOMA
  CORPORATE_INHOUSE
}

enum OfferingLevel {
  INITIAL
  INTERMEDIATE
  ADVANCED
}

enum AccessDurationPolicy {
  DAYS_7
  DAYS_30
  MONTHS_6
  PERMANENT
}

enum OfferingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Unidad en la que el admin captura la duración del curso (durationHours
// sigue guardando el NÚMERO tal cual lo escribió el admin en esa unidad —
// p. ej. durationUnit=WEEKS + durationHours=8 significa "8 semanas", no
// horas — se renombra la interpretación, no la columna, para no romper a
// todos los consumidores existentes de Course.durationHours).
enum DurationUnit {
  HOURS
  WEEKS
  MONTHS
}

model Course {
  id                    String               @id @default(uuid())
  slug                  String               @unique
  title                 Json // { es, en }
  subtitle              Json? // beneficio ("Aprende a liderar equipos remotos")
  description           Json?
  areaId                String
  area                  Area                 @relation(fields: [areaId], references: [id])
  subareaId             String?
  subarea               Subarea?             @relation(fields: [subareaId], references: [id])
  modality              OfferingModality
  type                  OfferingType         @default(COURSE)
  level                 OfferingLevel
  language              String               @default("es")
  subtitleLanguages     String[]             @default([])
  durationHours         Float
  durationUnit          DurationUnit         @default(HOURS)
  coverImageAssetId     String?
  syllabusAssetId       String? // sílabo del curso (PDF/Word) — visible para el alumno en el aula
  priceAmount           Decimal              @db.Decimal(10, 2)
  priceCurrency         String               @default("PEN")
  certificationIncluded Boolean              @default(true)
  accessDurationPolicy  AccessDurationPolicy @default(PERMANENT)
  status                OfferingStatus       @default(DRAFT)
  b2bAvailable          Boolean              @default(true)
  b2bPriceAmount        Decimal?             @db.Decimal(10, 2)

  // "El sistema no debe permitir que el usuario pueda descargar la clase
  // principal" — bloquea el atributo/enlace de descarga del video marcado
  // como Lesson.isMainContent (el material complementario sigue permitido).
  // Configurable por admin: se puede desactivar si el curso lo requiere.
  blockMainVideoDownload Boolean @default(true)

  // Descuento/oferta — % sobre priceAmount, con vencimiento opcional. Si
  // discountExpiresAt ya pasó, se trata como si no hubiera descuento (ver
  // catalog.service.ts) sin necesidad de un job que lo "apague" solo.
  discountPercent   Float?
  discountExpiresAt DateTime?

  // Plantilla de certificado específica para este curso. Si es null, el
  // emisor de certificados cae al comportamiento anterior (la plantilla
  // activa más reciente que coincida con el locale del alumno) — ver
  // CertificateService.checkAndIssueIfEligible.
  certificateTemplateId String?
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])

  // Rutas progresivas / recomendación
  prerequisiteCourseIds    String[] @default([])
  nextRecommendedCourseIds String[] @default([])

  // "El administrador podría crear secciones en la página — tal vez un
  // curso diga a quién va dirigido, tal vez no" — secciones libres y
  // opcionales que el admin arma por curso (a diferencia de `description`,
  // que es un solo bloque fijo). Shape: [{ id, title: {es,en?}, body: {es,en?} }].
  // Null/[] = el curso no muestra ninguna sección extra en su ficha pública.
  detailSections Json?

  // Plantilla de cabecera/pie/instrucciones para TODOS los exámenes de este
  // curso — "voy a hacer 10 exámenes para un curso, sería ilógico copiar la
  // cabecera cada vez". Cada Assessment puede personalizar la suya con sus
  // propios *Override (null = hereda esto); ver Assessment más abajo y
  // AssessmentService.getForStudent, que resuelve override ?? este valor.
  examHeaderText       Json?
  examFooterText       Json?
  examInstructionsText Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules        CourseModule[]
  liveSessions   LiveSession[]
  assessments    Assessment[]
  enrollments    Enrollment[]
  staff          CourseStaff[]
  programCourses ProgramCourse[]
  certificates   Certificate[]
  ratings        CourseRating[]
  seatPools      CompanySeatPool[]
  partnerships   CoursePartnership[]
  royalties      CourseRoyalty[]
  teacherRates   TeacherRate[]
  activityLogs   TeacherActivityLog[]
  calendarEvents CalendarEvent[]
  savedBy        SavedCourse[]

  @@index([areaId])
  @@index([status])
}

enum CourseStaffRole {
  TEACHER
  CO_TEACHER
  MODERATOR
}

model CourseStaff {
  id       String          @id @default(uuid())
  courseId String
  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     CourseStaffRole
  // "Por defecto el docente que tiene un curso asignado puede editar el
  // contenido; el administrador podría también bloquearle esos accesos" —
  // true por defecto (comportamiento de siempre); el admin lo puede apagar
  // sin desasignar al docente del curso (sigue viéndolo, solo no puede
  // modificarlo). Ver assertTeacherCanEditCourse.
  canEdit  Boolean         @default(true)

  @@unique([courseId, userId, role])
}

model CourseModule {
  id          String       @id @default(uuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order       Int
  title       Json
  lessons     Lesson[]
  // Lecturas/documentos del módulo (no de una lección puntual) — principales
  // o complementarias, ver Material.category.
  materials   Material[]
  // Exámenes vinculados a este módulo puntual (ver Assessment.moduleId) —
  // se desbloquean apenas el módulo se completa, no con todo el curso.
  assessments Assessment[]

  @@index([courseId])
}

enum LessonContentType {
  VIDEO
  PDF
  LINK
  TEXT
  ASSIGNMENT
  SCORM
  AUDIO
}

model Lesson {
  id               String            @id @default(uuid())
  moduleId         String
  module           CourseModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order            Int
  title            Json
  contentType      LessonContentType
  videoAssetId     String?
  // "¿Se puede crear... material audiovisual?" — contentType="AUDIO":
  // misma mecánica que VIDEO (subida, reproductor con controles nativos,
  // progreso/reanudar por segundo, bloqueo de adelantar sin haber
  // escuchado) pero sin las piezas que son específicamente de video
  // (marca de agua superpuesta, preguntas-checkpoint sobre el frame) — no
  // pedidas para audio y sin una superficie visual natural donde vivir.
  audioAssetId     String?
  // "Pongo un link para que se ejecute al inicio... no funciona" — bug real
  // confirmado: contentType=LINK se podía elegir al crear una lección, pero
  // no existía NINGÚN campo para guardar a qué URL apunta, y el reproductor
  // del alumno no tenía ninguna rama para mostrarlo — la lección quedaba
  // completamente inutilizable, con o sin "inicia el curso" marcado.
  externalUrl      String?
  durationMinutes  Int?
  isFreePreview    Boolean           @default(false)
  // "El administrador debe indicar si ese video inicia el curso o es
  // material complementario" — la lección marcada como iniciadora es la
  // que se reproduce inline apenas el alumno entra al curso (en vez de
  // asumir siempre "la primera por orden"). Como mucho una por curso —
  // se valida en AdminService, no a nivel de esquema.
  isCourseStarter  Boolean           @default(false)
  // Subtítulos/transcripción automática (Fase 2) — generados con Gemini
  // (ya integrado para el asistente de IA, sin credenciales nuevas):
  // transcribe el audio real del video y devuelve un WebVTT con marcas de
  // tiempo. NONE = nunca se pidió; PROCESSING = job encolado/corriendo;
  // READY = subtitlesAssetId tiene el .vtt listo; FAILED = ver subtitlesError.
  subtitlesAssetId String?
  subtitlesStatus  String            @default("NONE")
  subtitlesError   String?

  // "Me gustaría implementar módulos SCORM" — contentType="SCORM". El .zip
  // subido se desempaqueta y cada archivo se sube a S3/MinIO bajo el prefijo
  // scormPackagePrefix (p.ej. "scorm/{lessonId}/"), preservando su
  // estructura de carpetas relativa (el paquete referencia sus propios
  // assets — imágenes/css/js/otras páginas — por ruta relativa). El punto de
  // entrada real (leído de imsmanifest.xml) es scormEntryPath, relativo a
  // ese prefijo. scormVersion viene del schemaversion del manifest ("1.2" o
  // "2004"), usado para saber qué shim de API exponer (window.API vs
  // window.API_1484_11) — ver ScormService.
  scormPackagePrefix   String?
  scormEntryPath       String?
  scormVersion         String?
  // "Me gustaría poder crear un paquete SCORM en este sistema" — editor de
  // autoría (diapositivas de contenido/pregunta) DENTRO de Inkademy, en vez
  // de solo subir un .zip ya armado en Articulate/iSpring. Esta es la
  // definición editable ({ slides, passingScore }) que el constructor lee/
  // escribe; `null` = el paquete de esta lección se subió como .zip (no se
  // generó acá, no se puede "editar", solo reemplazar el archivo). El .zip
  // real que reproduce el alumno (imsmanifest.xml + index.html) se genera a
  // partir de esto y se sube al mismo `scormPackagePrefix` de siempre — ver
  // scorm-authoring.ts/ScormService.buildFromAuthoredContent.
  scormAuthoredContent Json?

  // "Cursos e-learning interactivos con evaluación formativa integrada" —
  // preguntas de autoevaluación DENTRO de la lección (feedback inmediato con
  // explicación, no cuenta para la nota/certificado — eso lo sigue haciendo
  // Assessment/ApprovalRule). Shape: { questions: [{ id, text, options[],
  // correctIndex, explanation? }] }. Null = lección normal sin quiz
  // formativo. Ver formativeQuizSchema en local-schemas.ts.
  formativeQuiz Json?

  materials             Material[]
  progress              LessonProgress[]
  notes                 LessonNote[]
  // Ver Assessment.scormLessonId — relación 1:1, un examen como mucho.
  scormBackedAssessment Assessment?      @relation("AssessmentScormLesson")

  @@index([moduleId])
}

// MAIN: lectura/documento principal. SUPPLEMENTARY: complementario (opcional para el alumno).
enum MaterialCategory {
  MAIN
  SUPPLEMENTARY
}

model Material {
  id            String           @id @default(uuid())
  // Un material cuelga de una lección puntual O de un módulo entero (lectura
  // general del módulo) — nunca de ambos. Antes solo existía a nivel de
  // lección.
  lessonId      String?
  lesson        Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  moduleId      String?
  module        CourseModule?    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String
  // Nullable — un material kind="link" no tiene ningún archivo subido, solo
  // externalUrl. Todo lo demás (pdf/slide/doc/sheet/image/video/template)
  // sigue requiriendo un assetId real.
  assetId       String?
  externalUrl   String?
  kind          String // pdf | slide | doc | sheet | image | video | audio | template | link
  // "Si hay tres videos, ¿cómo sabe el sistema cuál es primero?" — antes
  // los materiales solo se ordenaban por fecha de subida (createdAt), sin
  // forma de reordenarlos después. Ahora tienen su propio orden explícito,
  // independiente por categoría (MAIN se lee primero que SUPPLEMENTARY,
  // y dentro de cada una manda este número) — ver botones de mover
  // arriba/abajo en CourseEditor.tsx.
  order         Int              @default(0)
  category      MaterialCategory @default(MAIN)
  // Si es false, el material queda cargado pero oculto para el alumno (el
  // admin/docente lo sigue viendo) — por defecto todo se ve.
  visible       Boolean          @default(true)
  // "El admin/docente dueño de su curso podrá marcar si quiere que el
  // material pueda descargarse, visualizarse, o ambos" — mismo criterio
  // honesto que Course.blockMainVideoDownload: sin descarga significa sin
  // botón/atributo de descarga (fuerza vista previa), sin visualización
  // significa que el enlace siempre descarga en vez de abrir una vista
  // previa; ninguno de los dos es DRM real, solo lo que el navegador
  // permite sin descargar el archivo primero.
  allowDownload Boolean          @default(true)
  allowView     Boolean          @default(true)
  createdAt     DateTime         @default(now())

  // "SCORM ya existe pero solo como contenido principal de la lección, no
  // como material" — kind="scorm": mismos 4 campos que Lesson (ver arriba),
  // mismo mecanismo de subida/autoría/reproducción (ScormService), solo que
  // el prefijo de storage es scorm/material/{id}/ en vez de scorm/{lessonId}/.
  // El progreso vive en MaterialScormProgress (tabla aparte), NO en
  // MaterialProgress — así "aprobar el SCORM" no toca el cálculo de avance/
  // certificado, que sigue contando únicamente la fila de MaterialProgress
  // (creada por el mismo botón manual "Marcar como leído" de siempre).
  scormPackagePrefix   String?
  scormEntryPath       String?
  scormVersion         String?
  scormAuthoredContent Json?

  progress              MaterialProgress[]
  scormProgress         MaterialScormProgress[]
  // Ver Assessment.scormMaterialId — relación 1:1, un examen como mucho.
  scormBackedAssessment Assessment?             @relation("AssessmentScormMaterial")
}

model MaterialScormProgress {
  id                    String     @id @default(uuid())
  enrollmentId          String
  enrollment            Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  materialId            String
  material              Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  userId                String
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scormCompletionStatus String?
  scormScoreRaw         Float?
  scormInteractions     Json?
  scormLessonLocation   String?
  scormSuspendData      String?
  updatedAt             DateTime   @updatedAt

  @@unique([enrollmentId, materialId])
}

// "Si un curso tiene lecturas principales el alumno deberá marcar como
// leído para que el sistema entienda que ha leído ese documento; para las
// complementarias no" — solo se crea para materiales category=MAIN (se
// valida en el service, no acá); su existencia = leído, no hace falta un
// booleano. Alimenta el % de avance junto con LessonProgress.
model MaterialProgress {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  materialId   String
  material     Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt       DateTime   @default(now())

  @@unique([enrollmentId, materialId])
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum VirtualClassroomProviderType {
  TEAMS
  ZOOM
}

model LiveSession {
  id       String            @id @default(uuid())
  courseId String
  course   Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    Json?
  startsAt DateTime
  endsAt   DateTime
  timezone String            @default("America/Lima")
  capacity Int?
  status   LiveSessionStatus @default(SCHEDULED)

  // Docente que dicta esta sesión puntual — antes solo se sabía el curso,
  // no quién específicamente. Necesario para detectar choques de horario
  // (un mismo docente no puede tener dos sesiones que se solapen).
  teacherId String?
  teacher   User?   @relation("LiveSessionTeacher", fields: [teacherId], references: [id])
  // Agrupa las sesiones generadas de una sola vez como "repetir cada semana
  // hasta completar la duración del curso" — permite reprogramar/cancelar
  // la serie completa desde una sola referencia si hace falta.
  seriesId  String?

  // Integración de aula virtual (Microsoft Teams vía Graph API)
  provider          VirtualClassroomProviderType @default(TEAMS)
  providerMeetingId String?
  joinUrl           String?
  organizerUpn      String?
  recordingUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances    Attendance[]
  calendarEvents CalendarEvent[]

  @@index([courseId])
  @@index([startsAt])
  @@index([teacherId])
  @@index([seriesId])
}

model Program {
  id                    String               @id @default(uuid())
  slug                  String               @unique
  title                 Json
  description           Json?
  type                  OfferingType         @default(PROGRAM) // PROGRAM | DIPLOMA
  coverImageAssetId     String?
  priceAmount           Decimal              @db.Decimal(10, 2)
  priceCurrency         String               @default("PEN")
  certificationIncluded Boolean              @default(true)
  status                OfferingStatus       @default(DRAFT)
  certificateTemplateId String?
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  courses      ProgramCourse[]
  enrollments  Enrollment[]
  certificates Certificate[]
  seatPools    CompanySeatPool[]
}

model ProgramCourse {
  id         String  @id @default(uuid())
  programId  String
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id])
  order      Int
  isRequired Boolean @default(true)

  @@unique([programId, courseId])
}

// ---------------------------------------------------------------------------
// MATRÍCULA Y PROGRESO
// ---------------------------------------------------------------------------

enum OfferingKind {
  COURSE
  PROGRAM
}

enum EnrollmentSource {
  B2C_PURCHASE
  B2B_SEAT
  FREE
  ADMIN_GRANTED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

model Enrollment {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  offeringKind    OfferingKind
  courseId        String?
  course          Course?          @relation(fields: [courseId], references: [id])
  programId       String?
  program         Program?         @relation(fields: [programId], references: [id])
  companyId       String? // si vino de un cupo B2B
  company         Company?         @relation(fields: [companyId], references: [id])
  source          EnrollmentSource
  status          EnrollmentStatus @default(ACTIVE)
  accessExpiresAt DateTime?
  progressPct     Float            @default(0)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  // "En un curso asincrónico, si no lo pasa después de los intentos tendrá
  // que volver a repasar todo el material de nuevo" — al agotar los
  // intentos de un examen sin aprobar, EnrollmentService.resetMaterialForRetry
  // borra el avance de lecciones/lecturas y marca este momento; los
  // intentos de examen se vuelven a contar desde acá en adelante (ver
  // AssessmentService.createAttempt/handleAttemptFailedIfExhausted), así
  // que agotar attempts otra vez exige repasar todo de nuevo, no solo abre
  // la puerta indefinidamente.
  materialResetAt DateTime?

  lessonProgress        LessonProgress[]
  materialProgress      MaterialProgress[]
  materialScormProgress MaterialScormProgress[]
  attempts              AssessmentAttempt[]
  certificate           Certificate?
  rating                CourseRating?

  @@index([userId])
  @@index([companyId])
  @@index([courseId])
  @@index([programId])
}

// "Una vez que el alumno termina el curso debería aparecerle un mensaje
// para marcar las estrellas... si no responde el curso no se podrá dar
// por finalizado y el certificado no se podrá emitir." Una calificación
// por matrícula (no por curso — si el alumno vuelve a llevarlo, puede
// calificarlo de nuevo). `stars` 1-5. El admin decide si el promedio y
// los comentarios se muestran en el catálogo público (ver
// PlatformSettings.courseCardFields.showRating, mismo patrón que
// showTeacher/showDuration/etc.) — ver CertificateService.checkAndIssueIfEligible,
// que exige esta fila antes de emitir el certificado.
model CourseRating {
  id           String     @id @default(uuid())
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  stars        Int // 1-5
  comment      String?    @db.Text
  createdAt    DateTime   @default(now())

  @@index([courseId])
}

// "Hay una opción de Guardados. ¿Cómo guardo un curso? ¿Para qué sirve?" —
// antes la pestaña existía en la UI pero no había ningún modelo ni botón
// detrás; el alumno guarda un curso desde su ficha pública para decidir
// después, sin tener que comprarlo/matricularse todavía.
model SavedCourse {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

// ---------------------------------------------------------------------------
// Encuestas NPS (Fase 2, B2B) — "una encuesta tipo NPS con 1 pregunta...
// se podrá mandar al correo registrado de la empresa para recibir su
// feedback. La estructura de la pregunta la establece el administrador."
// Un solo NpsSurvey activo a la vez (mismo patrón "id: default" que
// SunatSettings/ChatbotSettings) con su pregunta editable; cada envío a
// una empresa crea un NpsSurveyResponse con un token único para que el
// contacto de la empresa responda SIN necesitar iniciar sesión (mismo
// patrón que la verificación pública de certificados).
// ---------------------------------------------------------------------------
model NpsSurvey {
  id            String   @id @default("default")
  question      Json // { es, en } — la pregunta principal (0-10) la redacta el admin
  // "Aparte una pregunta cualitativa que el administrador puede redactar" —
  // la segunda pregunta (el comentario abierto) también la puede editar el
  // admin ahora, antes era un texto fijo en código.
  commentPrompt Json?
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  responses NpsSurveyResponse[]
}

model NpsSurveyResponse {
  id          String    @id @default(uuid())
  surveyId    String
  survey      NpsSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  token       String    @unique @default(cuid())
  sentAt      DateTime  @default(now())
  sentToEmail String
  // 0-10, escala NPS estándar (9-10 promotor, 7-8 pasivo, 0-6 detractor) —
  // null hasta que el contacto responde. Ver NpsService.listResponses.
  score       Int?
  comment     String?   @db.Text
  respondedAt DateTime?

  @@index([companyId])
}

model LessonProgress {
  id                    String     @id @default(uuid())
  enrollmentId          String
  enrollment            Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId              String
  lesson                Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId                String
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  completed             Boolean    @default(false)
  lastPositionSeconds   Int        @default(0)
  // Reportado por el shim SCORM (cmi.core.lesson_status / cmi.completion_status
  // según la versión del paquete) — completed/passed marca `completed=true`
  // arriba también, para que el resto del sistema (avance del curso, etc.)
  // no tenga que saber nada de SCORM. scormScoreRaw es informativo (cmi.core.score.raw
  // / cmi.score.raw); no alimenta el certificado en esta fase.
  scormCompletionStatus String?
  scormScoreRaw         Float?
  // "Que no le falte nada" — analítica por pregunta (cmi.interactions.n.*,
  // no solo el puntaje final) del intento más reciente: [{id,type,response,correct}].
  scormInteractions     Json?
  // Reanudar donde quedó: cmi.core.lesson_location (1.2) / cmi.location
  // (2004) — el shim lo siembra en el próximo LMSInitialize de esta lección
  // (ver ScormService.getPlayerHtml). Sirve también para paquetes SUBIDOS de
  // terceros que ya implementan su propio reanudar, no es exclusivo del
  // editor de autoría.
  scormLessonLocation   String?
  // cmi.suspend_data (misma clave en 1.2 y 2004) — el "bookmark" real del
  // intento (qué respondió el alumno en cada diapositiva ya vista), no solo
  // en qué diapositiva está. Sin esto, reanudar movía el cursor a la
  // diapositiva correcta pero las respuestas previas se perdían al terminar
  // (contaban como no respondidas en el puntaje final).
  scormSuspendData      String?
  updatedAt             DateTime   @updatedAt

  @@unique([enrollmentId, lessonId])
}

// "Las notas del alumno en el reproductor de video se guardaban solo en
// localStorage — no sincronizaban entre dispositivos y se perdían si
// limpiaba el navegador." Una nota por alumno y por lección (no por
// intento ni por enrollment — si vuelve a matricularse, sigue viendo lo
// que anotó antes).
model LessonNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Attendance {
  id            String      @id @default(uuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt      DateTime?
  leftAt        DateTime?
  durationMin   Int?
  source        String      @default("teams_graph_report") // teams_graph_report | manual

  @@unique([liveSessionId, userId])
}

// ---------------------------------------------------------------------------
// EVALUACIÓN Y CERTIFICACIÓN
// ---------------------------------------------------------------------------

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  OPEN
  // Preguntas de "ordenar" — el alumno reordena una lista de opciones; se
  // califica automáticamente comparando el orden enviado contra
  // `correctAnswer` (array de ids en el orden correcto), ver assessment.service.ts.
  ORDERING
}

model QuestionBank {
  id        String     @id @default(uuid())
  areaId    String?
  name      String
  questions Question[]
}

model Question {
  id             String        @id @default(uuid())
  questionBankId String?
  questionBank   QuestionBank? @relation(fields: [questionBankId], references: [id])
  assessmentId   String?
  assessment     Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  type           QuestionType
  text           Json
  options        Json? // [{ id, text }] para choice/true_false
  correctAnswer  Json? // string | string[] según tipo (null para OPEN)
  points         Float         @default(1)
  tags           String[]      @default([])
  // Orden de autoría dentro del examen (controlado por drag-and-drop en el
  // builder) — no existía hasta ahora, así que las preguntas creadas antes
  // de esto reciben un orden estable pero arbitrario en la migración de
  // backfill (no hay createdAt del que derivar el orden real de creación).
  order          Int           @default(0)

  answers Answer[]
}

enum AssessmentQuestionOrder {
  FIXED
  RANDOM
}

// Cómo se le presentan las preguntas al alumno al rendir el examen: todas
// juntas en una sola pantalla, o una por una (sin poder volver atrás).
enum AssessmentDisplayMode {
  ALL_AT_ONCE
  ONE_BY_ONE
}

model Assessment {
  id                  String                  @id @default(uuid())
  courseId            String
  course              Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // "¿Cómo sabe cuál examen tomar en cada módulo?" — null = examen final del
  // curso (exige el curso completo, ver AssessmentService.createAttempt);
  // con valor = examen de ESE módulo puntual, se desbloquea apenas ese
  // módulo se completa (EnrollmentService.isModuleComplete), no todo el
  // curso. onDelete SetNull: borrar el módulo no borra el examen, solo lo
  // deja como "sin módulo" (pasa a examen final) para no perder su historial.
  moduleId            String?
  module              CourseModule?           @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  // Orden real de autoría/presentación — antes no existía y getMineDetail
  // ordenaba por `id` (UUID, sin ningún significado). Reordenable por
  // arrastre en el admin (ver AssessmentService.reorderAssessments).
  order               Int                     @default(0)
  title               Json
  type                String                  @default("quiz") // quiz | exam | assignment
  minScore            Float                   @default(70)
  maxAttempts         Int                     @default(3)
  timeLimitMinutes    Int?
  displayMode         AssessmentDisplayMode   @default(ALL_AT_ONCE)
  questionOrder       AssessmentQuestionOrder @default(FIXED)
  randomizeOptions    Boolean                 @default(false)
  questionsPerAttempt Int? // selección aleatoria desde banco
  availableFrom       DateTime?
  availableUntil      DateTime?

  // Examen "cualitativo" — en vez de preguntas tipeadas, el docente sube un
  // archivo (Word/Excel/PPT/imagen/PDF) que el alumno descarga, completa
  // offline y sube de vuelta; el docente lo califica a mano viendo el
  // archivo (no hay Question/Answer involucrados en este modo).
  sourceFileAssetId  String?
  sourceFileMimeType String?

  // "Hay cursos, por ejemplo un diplomado, que van a tener varios exámenes y
  // posiblemente haya una fórmula de ponderación" — % que este examen aporta
  // a la nota final del curso cuando ApprovalRule.scoreMode="WEIGHTED_AVERAGE"
  // (ver AssessmentService/course-score.ts). null/0 = no participa en la
  // fórmula. No se valida a nivel de esquema, pero AssessmentService.
  // updateAssessment SÍ rechaza guardar si la suma de los pesos del curso
  // (sin contar archivados) superaría 100 — "no puede exceder"; que falte
  // ponderar (<100) sí se permite, se avisa en el editor mientras se arma.
  weightPercent Float?

  // "Se debe de poder grabar para editarlo, eliminarlo, archivarlo" —
  // eliminar (hard delete) sigue bloqueado para siempre una vez que hay
  // intentos de alumnos (ver AssessmentService.deleteAssessment); archivar
  // es la salida real para ese caso: oculta el examen a los alumnos
  // (getForStudent/createAttempt lo rechazan) sin borrar el historial.
  archived Boolean @default(false)

  // Tipografía del título del examen (curada, ver BRAND_FONT_OPTIONS en el
  // frontend) — null usa la tipografía de encabezados de PlatformSettings.
  titleFontFamily String?

  // Cabecera/pie/instrucciones propias de ESTE examen — null hereda la
  // plantilla del curso (Course.examHeaderText/examFooterText/
  // examInstructionsText). Ver AssessmentService.getForStudent, que resuelve
  // override ?? valor del curso.
  headerTextOverride   Json?
  footerTextOverride   Json?
  instructionsOverride Json?

  // "¿Cómo se calcula la nota si el examen vive DENTRO del SCORM?" — este
  // Assessment puede estar "respaldado por SCORM" en vez de tener preguntas
  // propias: conserva moduleId/weightPercent/minScore con el mismo
  // significado de siempre (desbloqueo por módulo + peso en la fórmula
  // ponderada del curso), pero su puntaje se lee de
  // LessonProgress.scormScoreRaw / MaterialScormProgress.scormScoreRaw en
  // vez de AssessmentAttempt (ver course-score.ts resolveBestScore). @unique
  // en ambos = relación 1:1 — un SCORM respalda como máximo un examen (varios
  // "sub-exámenes" con peso DENTRO de un mismo paquete se resuelven con
  // ScormAuthoredContent.sections, no con varios Assessment apuntando al
  // mismo SCORM). Nunca se setean los dos a la vez (ver upsertAssessmentSchema).
  // Un mismo curso nunca mezcla exámenes nativos con respaldados por SCORM
  // (AssessmentService.assertConsistentAssessmentMode).
  scormLessonId   String?   @unique
  scormLesson     Lesson?   @relation("AssessmentScormLesson", fields: [scormLessonId], references: [id], onDelete: SetNull)
  scormMaterialId String?   @unique
  scormMaterial   Material? @relation("AssessmentScormMaterial", fields: [scormMaterialId], references: [id], onDelete: SetNull)

  questions Question[]
  attempts  AssessmentAttempt[]

  @@index([courseId])
  @@index([moduleId])
}

enum AttemptStatus {
  IN_PROGRESS
  GRADED
  PENDING_REVIEW
  PASSED
  FAILED
}

model AssessmentAttempt {
  id                 String        @id @default(uuid())
  assessmentId       String
  assessment         Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollmentId       String
  enrollment         Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptNumber      Int
  startedAt          DateTime      @default(now())
  submittedAt        DateTime?
  durationSeconds    Int? // submittedAt - startedAt, calculado al enviar (ver AssessmentService.submitAttempt)
  score              Float?
  status             AttemptStatus @default(IN_PROGRESS)
  // Solo para exámenes "cualitativos" (Assessment.sourceFileAssetId) — el
  // archivo que el alumno subió como su respuesta completa, pendiente de
  // que el docente lo revise y califique a mano.
  submissionAssetId  String?
  submissionMimeType String?
  // Alerta heurística de posible uso de IA/trampa: nota alta + tiempo de
  // resolución muy por debajo del mínimo esperado para leer y pensar el
  // examen. No es una acusación automática — el admin/empresa decide qué
  // hacer, ver AssessmentService.SUSPICIOUS_* y el reporte de empresa.
  flaggedSuspicious  Boolean       @default(false)
  // "El temporizador sigue corriendo en el servidor aunque el alumno cierre
  // la pestaña o se desconecte; al enviar las respuestas, verificar que no
  // haya excedido la duración máxima" — durationSeconds ya se calcula
  // server-side (startedAt real, no confiado al cliente); esto solo marca
  // si ese tiempo real superó el límite del examen (con margen de red) —
  // el intento igual se califica normalmente, pero queda auditado como
  // fuera de tiempo (mismo criterio no-bloqueante que flaggedSuspicious).
  timedOut           Boolean       @default(false)

  answers Answer[]

  @@index([assessmentId, userId])
}

model Answer {
  id         String            @id @default(uuid())
  attemptId  String
  attempt    AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question          @relation(fields: [questionId], references: [id])
  response   Json
  isCorrect  Boolean?
  score      Float?
  gradedById String?
  gradedBy   User?             @relation("GradedBy", fields: [gradedById], references: [id])
  gradedAt   DateTime?

  @@unique([attemptId, questionId])
}

// Reglas de habilitación de certificado por curso.
model ApprovalRule {
  id                   String  @id @default(uuid())
  courseId             String  @unique
  minProgressPct       Float   @default(100)
  minAttendancePct     Float? // solo aplica si el curso tiene sesiones en vivo
  // "El administrador puede poner un plazo de conexión mínima, por ejemplo
  // 20 min; si el alumno ha estado 20 min o más se le considera presente" —
  // umbral de minutos POR SESIÓN para contar como "asistió" (distinto de
  // minAttendancePct, que es el % de sesiones asistidas sobre el total).
  // null = cualquier conexión (joinedAt != null) cuenta, comportamiento de
  // siempre.
  minConnectionMinutes Int?
  minScore             Float   @default(70)
  requiresAssignment   Boolean @default(false)
  // BEST_ATTEMPT (default): la nota final es la mejor nota entre todos los
  // exámenes del curso — sirve para el caso normal (un examen, o varios
  // exámenes intercambiables). WEIGHTED_AVERAGE: la nota final es el
  // promedio ponderado de Assessment.weightPercent — para diplomados con
  // varios exámenes que pesan distinto. Ver computeCourseScore en
  // apps/api/src/modules/assessment/course-score.ts.
  scoreMode            String  @default("BEST_ATTEMPT")
}

// ---------------------------------------------------------------------------
// CONVENIOS INSTITUCIONALES (certificado con 3ra firma + facturación por
// convenio) — "a veces se tiene un convenio con un instituto o universidad
// de prestigio, donde debería estar la firma de esa institución también".
// ---------------------------------------------------------------------------

enum PartnerBillingType {
  FIXED // monto fijo (p.ej. mensual/único) independiente de cuántos cursos/certificados
  PER_COURSE // se cobra feeAmount por cada certificado emitido bajo un curso del convenio
  PER_PERIOD // se cobra feeAmount una vez por el rango startDate–endDate completo
  PER_ENROLLMENT // se cobra feeAmount por cada alumno matriculado (sin exigir que termine/certifique)
}

/// Institución socia (instituto/universidad) con la que Inkapitales tiene un
/// convenio para ciertos cursos: exige su firma en el certificado y/o cobra
/// por el convenio (fijo, por curso dictado, o por un plazo). Alimenta tanto
/// el certificado (3ra firma) como el estado de pérdidas y ganancias (ver
/// AdminService.getProfitAndLoss — el costo del convenio se trata como un
/// gasto más).
model PartnerInstitution {
  id               String             @id @default(uuid())
  name             String
  contactEmail     String?
  // Quién firma por la institución socia en el certificado — mismo patrón
  // que institutionSignatureName/Image de PlatformSettings pero para esta
  // institución en particular.
  signerName       String?
  signerTitle      String?
  signatureAssetId String?
  billingType      PartnerBillingType @default(FIXED)
  feeAmount        Decimal?           @db.Decimal(10, 2)
  feeCurrency      String             @default("PEN")
  // Si es true, la institución socia emite ELLA MISMA el comprobante SUNAT
  // al cliente final (con su propia serie/RUC) y transfiere el neto a
  // Inkapitales después — "podría pasar que la institución nos diga que
  // los que van a facturar son ellos y nos transfieren después". Cuando es
  // true, Inkapitales NO emite boleta/factura para las órdenes de los
  // cursos de este convenio (ver checkout/order finalize).
  invoicesDirectly Boolean            @default(false)
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  courses CoursePartnership[]
}

/// Asocia un curso concreto a un convenio, opcionalmente acotado a un rango
/// de fechas ("por un plazo dentro de los seleccionados"). Si startDate/
/// endDate son null, el convenio aplica a ese curso indefinidamente.
model CoursePartnership {
  id                   String             @id @default(uuid())
  courseId             String
  course               Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  partnerInstitutionId String
  partnerInstitution   PartnerInstitution @relation(fields: [partnerInstitutionId], references: [id], onDelete: Cascade)
  startDate            DateTime?
  endDate              DateTime?
  createdAt            DateTime           @default(now())

  @@unique([courseId, partnerInstitutionId])
  @@index([courseId])
  @@index([partnerInstitutionId])
}

enum PlatformLicenseStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

/// Registro de NEGOCIO de Inkapitales sobre terceros que arriendan el
/// sistema completo como instancia aislada/marca blanca (arriendo
/// aislado: cada arrendatario corre su propio despliegue con su propia
/// base de datos — ver docs/aprovisionar-instancia-arrendada.md — esto
/// NO es un tenant dentro de esta misma base de datos). Vive acá para que
/// Inkapitales gestione sus contratos de arriendo desde su propio panel,
/// no para que el sistema opere multi-tenant sobre esta tabla.
model PlatformLicense {
  id            String                @id @default(uuid())
  clientName    String
  domain        String?
  deploymentUrl String?
  billingCycle  BillingCycle
  priceAmount   Decimal               @db.Decimal(10, 2)
  currency      String                @default("PEN")
  startsAt      DateTime
  endsAt        DateTime
  status        PlatformLicenseStatus @default(ACTIVE)
  notes         String?               @db.Text
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, endsAt])
}

// HTML: la plantilla es un documento HTML con tags {{tag}} (ver
// certificate.processor.ts renderPlaceholders) que se renderiza con
// Puppeteer. BACKGROUND: la plantilla es un archivo de diseño ya
// maquetado (PDF, PNG o JPG, ver backgroundMimeType) sobre el que se
// "estampan" los tags en las coordenadas de tagPositions usando pdf-lib
// — si el fondo es PDF se preserva calidad vectorial; si es PNG/JPG se
// incrusta como imagen de fondo de una página nueva.
enum CertificateTemplateSourceType {
  HTML
  BACKGROUND
}

model CertificateTemplate {
  id           String   @id @default(uuid())
  name         String
  locale       String   @default("es")
  htmlTemplate String   @db.Text // solo aplica si sourceType=HTML (se guarda "" si es BACKGROUND)
  version      Int      @default(1)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  sourceType         CertificateTemplateSourceType @default(HTML)
  backgroundAssetId  String? // PDF/PNG/JPG subido como diseño de fondo — solo si sourceType=BACKGROUND
  backgroundMimeType String? // application/pdf | image/png | image/jpeg
  // Tamaño de página en puntos PDF (72pt = 1 pulgada). Si el fondo es un PDF,
  // se ignoran y se usa el tamaño real de esa página.
  pageWidthPt        Float?                        @default(841.89) // A4 horizontal
  pageHeightPt       Float?                        @default(595.28)
  // [{ tag, xPercent, yPercent, fontSizePt?, color?, align?, widthPercent?, heightPercent? }]
  // Posición de cada tag relativa a la página (0-100%, origen arriba-izquierda,
  // igual que en la vista previa) — solo aplica si sourceType=BACKGROUND.
  tagPositions       Json?

  certificates Certificate[]
  courses      Course[]
  programs     Program[]
}

model Certificate {
  id               String              @id @default(uuid())
  code             String              @unique @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  courseId         String?
  course           Course?             @relation(fields: [courseId], references: [id])
  programId        String?
  program          Program?            @relation(fields: [programId], references: [id])
  enrollmentId     String              @unique
  enrollment       Enrollment          @relation(fields: [enrollmentId], references: [id])
  templateId       String
  template         CertificateTemplate @relation(fields: [templateId], references: [id])
  templateVersion  Int
  finalScore       Float?
  issuedAt         DateTime            @default(now())
  pdfAssetId       String?
  qrUrl            String?
  criteriaSnapshot Json // reglas cumplidas al momento de emitir, para trazabilidad
  revoked          Boolean             @default(false)
  // A quién se envió realmente el correo al emitirse (STUDENT | COMPANY_ADMIN
  // | BOTH) — snapshot del momento de emisión, igual que criteriaSnapshot:
  // si la empresa cambia su preferencia después, los certificados ya
  // emitidos no deben "cambiar de historia". El alumno lo ve en /campus/certificados
  // para saber a dónde llegó (o no) el correo — la descarga directa nunca
  // depende de este valor.
  deliveredTo      String              @default("STUDENT")

  @@index([userId])
  @@index([code])
}

// ---------------------------------------------------------------------------
// COMERCIO
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  companyId String?
  company   Company?    @relation(fields: [companyId], references: [id])
  subtotal  Decimal     @db.Decimal(10, 2)
  discount  Decimal     @default(0) @db.Decimal(10, 2)
  tax       Decimal     @default(0) @db.Decimal(10, 2)
  total     Decimal     @db.Decimal(10, 2)
  currency  String      @default("PEN")
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Datos del comprador para la boleta/factura electrónica (SUNAT). Se
  // capturan en el checkout (ver checkoutSchema) y se guardan en la orden —
  // no en ElectronicInvoice directamente — porque finalizeOrderPaid() puede
  // ejecutarse más tarde (webhook async, o a futuro una confirmación manual
  // de transferencia) y para entonces ya no tenemos el body original del
  // POST /checkout. Catálogo 06 SUNAT: 1=DNI, 6=RUC, 4=Carné ext., 7=Pasaporte,
  // 0=extranjero sin documento.
  buyerDocumentType   String?
  buyerDocumentNumber String?
  buyerLegalName      String?
  buyerCountry        String?

  items             OrderItem[]
  payments          Payment[]
  electronicInvoice ElectronicInvoice?
  electronicNotes   ElectronicNote[]
}

enum ElectronicDocumentType {
  BOLETA
  FACTURA
}

enum ElectronicDocumentStatus {
  PENDING // encolada, el worker todavía no la procesa
  SIMULATED // sin credenciales reales de SUNAT configuradas (dev)
  ACCEPTED
  REJECTED
  ERROR
}

/// Comprobante de pago electrónico (boleta/factura SUNAT) de una Order.
/// Se emite automáticamente cuando la Order pasa a PAID — sin importar si
/// fue un pago con tarjeta (Culqi/Stripe, automático) o una confirmación
/// manual futura (ej. transferencia bancaria) — y se omite por completo si
/// el total de la orden es 0 (cursos gratuitos).
model ElectronicInvoice {
  id                  String                   @id @default(uuid())
  orderId             String                   @unique
  order               Order                    @relation(fields: [orderId], references: [id])
  documentType        ElectronicDocumentType
  series              String
  correlativo         Int
  // Catálogo 06 de SUNAT: 1=DNI, 6=RUC, 4=Carné extranjería, 7=Pasaporte,
  // 0=Doc.trib.no.dom.sin.RUC (comprador extranjero sin ninguno de los anteriores).
  buyerDocumentType   String
  buyerDocumentNumber String
  buyerLegalName      String
  buyerCountry        String                   @default("PE")
  currency            String
  totalAmount         Decimal                  @db.Decimal(10, 2)
  xml                 String?                  @db.Text
  cdrXml              String?                  @db.Text
  status              ElectronicDocumentStatus @default(SIMULATED)
  sunatResponseCode   String?
  sunatDescription    String?
  pdfAssetId          String?
  createdAt           DateTime                 @default(now())

  @@unique([documentType, series, correlativo])
}

enum ElectronicNoteType {
  CREDIT // Nota de crédito — catálogo 09 SUNAT (anulación, descuento, etc.)
  DEBIT // Nota de débito — catálogo 10 SUNAT (intereses, aumento de valor, etc.)
}

/// Nota de crédito/débito SUNAT, ligada a la ElectronicInvoice original que
/// ajusta. Hoy el único disparador real es "el comprador desiste de la
/// compra" (CommerceService.cancelOrder) -> siempre genera CREDIT con
/// motivo "01" (anulación de la operación). DEBIT queda modelado y con XML
/// soportado (ver invoice.processor.ts en apps/worker) para casos futuros
/// (p.ej. corrección de un cobro de menos) pero sin un endpoint que lo
/// dispare todavía.
model ElectronicNote {
  id                   String                   @id @default(uuid())
  orderId              String
  order                Order                    @relation(fields: [orderId], references: [id])
  noteType             ElectronicNoteType
  series               String
  correlativo          Int
  // Documento SUNAT que esta nota ajusta (la ElectronicInvoice original).
  referenceDocType     ElectronicDocumentType
  referenceSeries      String
  referenceCorrelativo Int
  // Catálogo 09 (crédito) / catálogo 10 (débito) de SUNAT.
  reasonCode           String
  reasonDescription    String
  currency             String
  totalAmount          Decimal                  @db.Decimal(10, 2)
  xml                  String?                  @db.Text
  cdrXml               String?                  @db.Text
  status               ElectronicDocumentStatus @default(PENDING)
  sunatResponseCode    String?
  sunatDescription     String?
  pdfAssetId           String?
  createdAt            DateTime                 @default(now())

  @@unique([noteType, series, correlativo])
}

model OrderItem {
  id           String       @id @default(uuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offeringKind OfferingKind
  courseId     String?
  programId    String?
  seatPoolQty  Int? // si la compra es de cupos B2B
  unitPrice    Decimal      @db.Decimal(10, 2)
  quantity     Int          @default(1)
}

enum PaymentProviderType {
  CULQI
  STRIPE
  PAYPAL
  // Venta B2B negociada fuera de pasarela (cotización aceptada, transferencia
  // bancaria) — ver CompaniesService.convertQuoteToSeatPool. El pago ya
  // ocurrió por fuera; esto solo lo registra para que la venta SÍ quede en
  // los reportes de ingresos y genere su comprobante SUNAT, como cualquier
  // otra orden pagada.
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id            String              @id @default(uuid())
  orderId       String
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentProviderType
  providerRef   String? // charge id / payment intent id
  status        PaymentStatus       @default(PENDING)
  amount        Decimal             @db.Decimal(10, 2)
  currency      String
  // Método real dentro del proveedor — p.ej. Culqi devuelve `source.type`
  // ("card", "yape", "plin", ...) en la respuesta del cargo. Permite
  // diferenciar el % de comisión de cada billetera (PlatformSettings.
  // yapeFeePercent/plinFeePercent — separadas, cada banco cobra distinto)
  // del de tarjeta dentro del mismo proveedor CULQI. Null si no se pudo
  // determinar (p.ej. cargos simulados en modo dev sin secret key).
  paymentMethod String?
  receiptUrl    String?
  paidAt        DateTime?
  createdAt     DateTime            @default(now())
}

model CompanySeatPool {
  id             String       @id @default(uuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offeringKind   OfferingKind
  courseId       String?
  course         Course?      @relation(fields: [courseId], references: [id])
  programId      String?
  program        Program?     @relation(fields: [programId], references: [id])
  seatsPurchased Int
  seatsUsed      Int          @default(0)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([companyId])
}

enum QuoteStatus {
  REQUESTED
  SENT
  ACCEPTED
  REJECTED
}

model Quote {
  id                  String      @id @default(uuid())
  companyId           String
  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedByUserId   String
  offeringDescription String      @db.Text
  status              QuoteStatus @default(REQUESTED)
  salesOwner          String?
  // Pipeline comercial (Fase 2) — antes un Quote era solo el pedido inicial
  // en texto libre: no había forma de fijar un monto real, hacerle
  // seguimiento con fecha de vigencia, o convertirlo en cupos reales al
  // aceptarse. `courseId`/`programId`/`convertedSeatPoolId` son referencias
  // sueltas (sin `@relation`, mismo patrón que AuditLog.entityId) — evita
  // tocar Course/Program/CompanySeatPool solo para agregar una relación
  // inversa que nadie más necesita.
  courseId            String?
  programId           String?
  seatsQuoted         Int?
  amount              Decimal?    @db.Decimal(10, 2)
  currency            String?
  validUntil          DateTime?
  // Notas internas del equipo comercial — jamás se exponen a la empresa
  // (a diferencia de offeringDescription, que sí escribió la empresa).
  internalNotes       String?     @db.Text
  respondedAt         DateTime?
  convertedSeatPoolId String?     @unique
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

