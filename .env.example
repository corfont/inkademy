# ============================================================
# Inkademy — variables de entorno
# Copiar como .env y completar. Los valores de ejemplo funcionan
# para desarrollo local con docker-compose (Mailhog/MinIO).
# ============================================================

# --- General ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en
DEFAULT_CURRENCY=PEN
SUPPORTED_CURRENCIES=PEN,USD

# --- Base de datos (Postgres). En producción: apuntar a un Postgres
# administrado (RDS / Cloud SQL / Azure Database for PostgreSQL) sin
# cambiar de motor ni de esquema. ---
DATABASE_URL=postgresql://inkademy:inkademy@localhost:5432/inkademy?schema=public

# --- Redis (colas BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OAuth Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- OAuth / Graph Microsoft (mismo tenant se usa para login "Microsoft"
# y para crear reuniones de Teams vía Graph API) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_CALLBACK_URL=http://localhost:4000/auth/microsoft/callback
# Permiso de aplicación requerido en Azure AD: OnlineMeetings.ReadWrite.All
# (consentimiento de administrador). Sin estas credenciales, el adapter de
# Teams funciona en modo "simulado" para desarrollo (ver TeamsProvider).
MS_TEAMS_ORGANIZER_UPN=

# --- Pagos ---
# Culqi (Perú: tarjetas, Yape, PagoEfectivo)
CULQI_PUBLIC_KEY=pk_test_xxx
CULQI_SECRET_KEY=sk_test_xxx
# Stripe (compradores internacionales)
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Almacenamiento de objetos (S3-compatible). En dev: MinIO. En prod:
# S3 / Azure Blob / GCS sin cambiar el código (API S3). ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=inkademy
S3_SECRET_KEY=inkademy123
S3_BUCKET=inkademy-assets
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/inkademy-assets

# --- Email transaccional (dev: Mailhog vía SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Inkademy <no-reply@inkademy.com>"

# --- WhatsApp Business (Fase 2, deshabilitado por defecto) ---
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER_TOKEN=

# --- Frontend (Next.js, deben empezar con NEXT_PUBLIC_ para llegar al cliente) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxx
