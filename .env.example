# ============================================================
# Inkademy — variables de entorno
# Copiar como .env y completar. Los valores de ejemplo funcionan
# para desarrollo local con docker-compose (Mailhog/MinIO).
# ============================================================

# --- General ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en
DEFAULT_CURRENCY=PEN
SUPPORTED_CURRENCIES=PEN,USD

# --- Base de datos (Postgres). En producción: apuntar a un Postgres
# administrado (RDS / Cloud SQL / Azure Database for PostgreSQL) sin
# cambiar de motor ni de esquema. ---
DATABASE_URL=postgresql://inkademy:inkademy@localhost:5432/inkademy?schema=public

# --- Redis (colas BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OAuth Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- OAuth / Graph Microsoft (mismo tenant se usa para login "Microsoft"
# y para crear reuniones de Teams vía Graph API) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_CALLBACK_URL=http://localhost:4000/auth/microsoft/callback
# Permiso de aplicación requerido en Azure AD: OnlineMeetings.ReadWrite.All
# (consentimiento de administrador). Sin estas credenciales, el adapter de
# Teams funciona en modo "simulado" para desarrollo (ver TeamsProvider).
MS_TEAMS_ORGANIZER_UPN=

# --- Pagos ---
# Culqi (Perú: tarjetas, Yape, PagoEfectivo). Sin SECRET_KEY, CulqiProvider
# simula un cobro exitoso (modo dev) — igual que TeamsProvider con MS_*.
# Poner las claves reales de https://culqi.com (modo test o live) aquí.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Stripe (compradores internacionales). Mismo comportamiento: sin
# SECRET_KEY, StripeProvider simula el cobro. Claves de https://stripe.com.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Almacenamiento de objetos (S3-compatible). En dev: MinIO. En prod:
# S3 / Azure Blob / GCS sin cambiar el código (API S3). ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=inkademy
S3_SECRET_KEY=inkademy123
S3_BUCKET=inkademy-assets
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/inkademy-assets

# --- Email transaccional (dev: Mailhog vía SMTP) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Inkademy <no-reply@inkademy.com>"

# --- WhatsApp Business (Fase 2, deshabilitado por defecto) ---
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER_TOKEN=

# --- Facturación electrónica SUNAT (Perú). Si se deja SUNAT_SOL_USER /
# SUNAT_SOL_PASSWORD vacíos, el worker genera y firma el XML pero NO lo
# envía a SUNAT (queda en estado SIMULATED) — mismo patrón que Culqi/Stripe
# sin secret key. SUNAT_ENV=beta usa el ambiente de pruebas de SUNAT
# (e-beta.sunat.gob.pe); production usa el servicio real (requiere RUC
# habido, clave SOL de un usuario secundario con permiso de facturación
# electrónica, y un certificado digital de una entidad certificadora
# acreditada — un certificado autofirmado SOLO funciona en beta).
SUNAT_ENV=beta
SUNAT_RUC=
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=
SUNAT_RAZON_SOCIAL="Inkapitales SAC"
SUNAT_ADDRESS="Lima, Peru"
SUNAT_UBIGEO=150101
SUNAT_BOLETA_SERIES=B001
SUNAT_FACTURA_SERIES=F001
# Series de notas de crédito (se emiten al cancelar una orden pagada, ver
# POST /orders/:id/cancel — ADMIN/SUPPORT). Notas de débito comparten el
# mismo modelo pero hoy no hay ningún flujo que las dispare.
SUNAT_BOLETA_CREDIT_SERIES=BC01
SUNAT_FACTURA_CREDIT_SERIES=FC01
# Certificado digital real en PEM (obligatorio en producción). Si se dejan
# vacíos, el worker genera un certificado autofirmado válido solo para
# SUNAT_ENV=beta. Se aceptan con saltos de línea escapados como "\n".
SUNAT_CERT_PEM=
SUNAT_CERT_KEY_PEM=
# EXONERADO (default, servicios de enseñanza reglada — Apéndice II Ley del
# IGV) o GRAVADO (18% IGV) — confirmar con el contador de la empresa según
# el tipo real de servicio facturado.
SUNAT_TAX_AFFECTATION=EXONERADO

# --- Frontend (Next.js, deben empezar con NEXT_PUBLIC_ para llegar al cliente) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
